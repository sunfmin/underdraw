{
  "platform": "android",
  "language": "kotlin",
  "stack": "Jetpack Compose + Material 3",
  "testId": "Modifier.testTag(\"{id}\")（需 testTagsAsResourceId = true 才能被 uiautomator 读到）",
  "elementTree": "adb shell uiautomator dump → XML，按 resource-id 读 bounds",
  "tokenNaming": { "pattern": "AppTheme.{group}.{name}", "example": "color.primary → AppTheme.color.primary；space.4 → AppTheme.space._4（数字开头的名字前加 _）" },
  "breakpoints": "WindowSizeClass：COMPACT → compact，MEDIUM/EXPANDED → regular",
  "components": {
    "Screen": "Scaffold",
    "NavBar": "TopAppBar；transparentOverContent → 透明背景 + 滚动后变色（TopAppBarScrollBehavior）",
    "IconButton": "IconButton { Icon(contentDescription = label) }",
    "Button": "variant primary → Button，secondary → OutlinedButton",
    "Link": "TextButton",
    "Text": "Text；maxLines + overflow = Ellipsis；role heading → Modifier.semantics { heading() }",
    "Scroll": "LazyColumn（内容长，用懒加载）",
    "Stack": "Column", "Row": "Row",
    "Columns": "compact → Column；regular → Row + Modifier.weight",
    "Grid": "LazyVerticalGrid 或 FlowRow",
    "ImageCarousel": "HorizontalPager + 计数器",
    "ImageGrid": "自定义 Layout（仅平板 regular）",
    "Carousel": "LazyRow + snap fling",
    "Card": "OutlinedCard / ElevatedCard",
    "StickyBar": "Scaffold(bottomBar = …) + navigationBarsPadding()",
    "List": "Column", "ListItem": "ListItem(headlineContent, supportingContent, leadingContent)",
    "Section": "Column + 标题 Text",
    "Badge": "AssistChip 或自定义 Surface", "Rating": "Row(Icon(Star), Text)", "Metric": "Column",
    "Avatar": "AsyncImage(Coil) + CircleShape",
    "Divider": "HorizontalDivider()",
    "Skeleton": "placeholder shimmer 修饰符",
    "EmptyState": "Column 居中 Icon + Text + Button",
    "DateRangePicker": "Material 3 DateRangePicker（原生支持范围）",
    "DateField": "OutlinedTextField(readOnly) 点击打开 DateRangePickerDialog",
    "FieldGroup": "OutlinedCard 包裹",
    "Stepper": "自研 − / + IconButton",
    "PriceBreakdown": "Column of Row(SpaceBetween)",
    "Map": "Maps Compose GoogleMap；approx → Circle，否则 Marker"
  },
  "actions": {
    "navigate": "navController.navigate(route)", "back": "系统返回 + navController.popBackStack()",
    "open": "ModalBottomSheet", "share": "Intent.ACTION_SEND + createChooser",
    "toggle": "ViewModel 状态取反", "scrollTo": "LazyListState.animateScrollToItem",
    "call": "Repository 同名的 suspend 函数，由 ViewModel 调用；命令乐观更新 + HapticFeedback", "set": "ViewModel 状态更新"
  }
}
