{
  "screen": "Checkout",
  "title": "确认订单",
  "locale": "zh-CN",
  "tokens": "tokens.json",
  "$comment": "The last step before paying: where it goes, how fast, how it is paid, what it costs. Phone: one column with a sticky total. Desktop: the order on the left, the summary card on the right.",

  "data": {
    "cart": "Cart",
    "address": "Address?",
    "delivery": "Delivery",
    "promo": "Promo",
    "payment": "Payment",
    "summary": "Summary"
  },
  "types": {
    "Cart": {
      "items": "CartItem[] 1..50",
      "itemCount": { "type": "int 1..", "derived": "sum of the items' quantities" },
      "unavailableCount": { "type": "int 0..", "derived": "items that are out of stock" }
    },
    "CartItem": {
      "id": "string",
      "name": "string 1..60",
      "variant": "string ..40",
      "image": "image",
      "price": "money",
      "quantity": "int 1..10",
      "lineTotal": { "type": "money", "derived": "price × quantity" },
      "inStock": "bool = true"
    },
    "Address": {
      "name": "string 1..20",
      "phone": "string",
      "line": { "type": "string 1..120", "doc": "Province, city, district and street, as one line" }
    },
    "Delivery": {
      "options": "DeliveryOption[] 1..4"
    },
    "DeliveryOption": {
      "id": "string",
      "label": "string",
      "eta": { "type": "string", "doc": "When it arrives, in words: 预计 10月16日 送达" },
      "price": "money",
      "free": { "type": "bool = false", "derived": "price is zero" },
      "selected": "bool = false"
    },
    "Promo": {
      "code": "string ..20 = \"\"",
      "status": "PromoStatus",
      "discount": { "type": "money?", "doc": "Only when the code is applied" },
      "message": { "type": "string?", "doc": "Why the code was refused" }
    },
    "PromoStatus": "enum(none, applied, invalid)",
    "Payment": {
      "method": "PayMethod",
      "options": "PaymentOption[] 1..",
      "cardLast4": { "type": "string?", "doc": "The saved card; null when none is saved" }
    },
    "PayMethod": "enum(card, alipay, wechat)",
    "PaymentOption": {
      "id": "string",
      "label": "string",
      "icon": "icon",
      "selected": { "type": "bool = false", "derived": "method is this option" }
    },
    "Summary": {
      "subtotal": "money",
      "shipping": "money",
      "total": { "type": "money", "derived": "subtotal + shipping − discount" }
    }
  },

  "conditions": {
    "hasAddress": { "when": "address != null", "label": "Has a delivery address" },
    "hasUnavailable": { "when": "cart.unavailableCount > 0", "label": "Some items are out of stock" },
    "promoApplied": { "when": "promo.status == \"applied\" && promo.discount != null", "label": "Promo code applied" },
    "promoInvalid": { "when": "promo.status == \"invalid\" && promo.message != null", "label": "Promo code refused" },
    "payByCard": { "when": "payment.method == \"card\"", "label": "Paying by card" },
    "cardSaved": { "when": "payByCard && payment.cardLast4 != null", "label": "Paying with a saved card" },
    "newCard": { "when": "payByCard && payment.cardLast4 == null", "label": "Paying with a new card" },
    "canPlace": { "when": "hasAddress && !hasUnavailable", "label": "Order can be placed" }
  },

  "fixtures": {
    "default": {
      "cart": {
        "itemCount": 4,
        "unavailableCount": 0,
        "items": [
          { "id": "p1", "name": "无线降噪耳机 Pro", "variant": "午夜黑", "image": "headphones.jpg",
            "price": { "amount": 1299, "currency": "CNY" }, "quantity": 1,
            "lineTotal": { "amount": 1299, "currency": "CNY" } },
          { "id": "p2", "name": "皮质耳机收纳包", "variant": "焦糖棕", "image": "case.jpg",
            "price": { "amount": 199, "currency": "CNY" }, "quantity": 1,
            "lineTotal": { "amount": 199, "currency": "CNY" } },
          { "id": "p3", "name": "USB-C 快充线 1m", "variant": "白色", "image": "cable.jpg",
            "price": { "amount": 49, "currency": "CNY" }, "quantity": 2,
            "lineTotal": { "amount": 98, "currency": "CNY" } }
        ]
      },
      "address": { "name": "孙小明", "phone": "138 **** 5678", "line": "上海市 徐汇区 漕溪北路 88 号 2 栋 1203 室" },
      "delivery": {
        "options": [
          { "id": "standard", "label": "标准配送", "eta": "预计 10月18日 送达",
            "price": { "amount": 0, "currency": "CNY" }, "free": true, "selected": true },
          { "id": "express", "label": "次日达", "eta": "预计 10月15日 送达",
            "price": { "amount": 18, "currency": "CNY" } }
        ]
      },
      "promo": { "code": "", "status": "none" },
      "payment": {
        "method": "card",
        "cardLast4": "4242",
        "options": [
          { "id": "card", "label": "银行卡", "icon": "credit_card", "selected": true },
          { "id": "alipay", "label": "支付宝", "icon": "account_balance_wallet" },
          { "id": "wechat", "label": "微信支付", "icon": "chat" }
        ]
      },
      "summary": {
        "subtotal": { "amount": 1596, "currency": "CNY" },
        "shipping": { "amount": 0, "currency": "CNY" },
        "total": { "amount": 1596, "currency": "CNY" }
      }
    },
    "express-alipay": {
      "$patch": "default",
      "delivery": {
        "options": [
          { "id": "standard", "label": "标准配送", "eta": "预计 10月18日 送达",
            "price": { "amount": 0, "currency": "CNY" }, "free": true },
          { "id": "express", "label": "次日达", "eta": "预计 10月15日 送达",
            "price": { "amount": 18, "currency": "CNY" }, "selected": true }
        ]
      },
      "payment": {
        "method": "alipay",
        "options": [
          { "id": "card", "label": "银行卡", "icon": "credit_card" },
          { "id": "alipay", "label": "支付宝", "icon": "account_balance_wallet", "selected": true },
          { "id": "wechat", "label": "微信支付", "icon": "chat" }
        ]
      },
      "summary": {
        "shipping": { "amount": 18, "currency": "CNY" },
        "total": { "amount": 1614, "currency": "CNY" }
      }
    },
    "promo-applied": {
      "$patch": "default",
      "promo": { "code": "SAVE50", "status": "applied", "discount": { "amount": 50, "currency": "CNY" } },
      "summary": { "total": { "amount": 1546, "currency": "CNY" } }
    },
    "promo-invalid": {
      "$patch": "default",
      "promo": { "code": "FALL2025", "status": "invalid", "message": "优惠码已过期" }
    },
    "no-address-new-card": {
      "$patch": "default",
      "address": null,
      "payment": { "cardLast4": null }
    },
    "out-of-stock": {
      "$patch": "default",
      "cart": {
        "unavailableCount": 1,
        "items": [
          { "id": "p1", "name": "无线降噪耳机 Pro", "variant": "午夜黑", "image": "headphones.jpg",
            "price": { "amount": 1299, "currency": "CNY" }, "quantity": 1,
            "lineTotal": { "amount": 1299, "currency": "CNY" } },
          { "id": "p2", "name": "皮质耳机收纳包", "variant": "焦糖棕", "image": "case.jpg",
            "price": { "amount": 199, "currency": "CNY" }, "quantity": 1,
            "lineTotal": { "amount": 199, "currency": "CNY" }, "inStock": false },
          { "id": "p3", "name": "USB-C 快充线 1m", "variant": "白色", "image": "cable.jpg",
            "price": { "amount": 49, "currency": "CNY" }, "quantity": 2,
            "lineTotal": { "amount": 98, "currency": "CNY" } }
        ]
      }
    }
  },

  "components": {
    "nav": {
      "id": "nav", "kind": "NavBar",
      "leading": { "id": "nav-back", "kind": "IconButton", "icon": "arrow_back", "on": { "tap": { "back": true } } },
      "children": { "id": "nav-title", "kind": "Text", "text": "确认订单", "font": "font.subhead" },
      "trailing": { "id": "nav-secure", "kind": "Glyph", "icon": "lock", "font": "font.caption" }
    },
    "place-order": {
      "id": "place-order", "kind": "Button", "variant": "primary",
      "text": "提交订单 · {summary.total|money}",
      "disabled": "!canPlace",
      "on": { "tap": { "submit": "PlaceOrder" } }
    },
    "place-hint": {
      "id": "place-hint", "kind": "Text", "if": "!canPlace", "font": "font.caption", "color": "color.danger",
      "text": { "cases": [
        { "if": "!hasAddress", "then": "请先添加收货地址" },
        { "else": "有商品缺货，移除后才能提交" }
      ] }
    },
    "summary": {
      "id": "summary", "kind": "Section", "title": "订单金额", "gap": "space.3",
      "children": [
        { "id": "sum-subtotal", "kind": "SummaryLine", "label": "商品小计（{cart.itemCount} 件）", "value": "{summary.subtotal|money}" },
        { "id": "sum-shipping", "kind": "SummaryLine", "label": "运费", "value": "{summary.shipping|money}" },
        { "id": "sum-discount", "kind": "SummaryLine", "if": "promoApplied", "label": "优惠码 {promo.code}", "value": "−{promo.discount|money}" },
        { "id": "sum-divider", "kind": "Divider" },
        { "id": "sum-total", "kind": "SummaryLine", "strong": true, "label": "应付合计", "value": "{summary.total|money}" }
      ]
    }
  },

  "root": {
    "id": "checkout", "kind": "Screen",
    "children": [
      { "ref": "nav" },
      {
        "id": "body", "kind": "Columns", "padding": "space.4",
        "columns": { "compact": ["1fr"], "regular": ["62%", "1fr"] },
        "children": [
          {
            "id": "main", "kind": "Stack", "gap": "space.6",
            "children": [
              {
                "id": "sec-address", "kind": "Section", "title": "收货地址", "gap": "space.2",
                "children": [
                  { "id": "address", "kind": "ListItem", "if": "hasAddress",
                    "leadingIcon": "location_on",
                    "title": "{address.name}  {address.phone}",
                    "detail": "{address.line}",
                    "trailingIcon": "chevron_right",
                    "on": { "tap": { "navigate": "AddressBook" } } },
                  { "id": "address-add", "kind": "ListItem", "if": "!hasAddress",
                    "leadingIcon": "add_location_alt",
                    "title": "添加收货地址",
                    "detail": "下单前需要一个收货地址",
                    "trailingIcon": "chevron_right",
                    "on": { "tap": { "navigate": "AddressForm" } } }
                ]
              },
              {
                "id": "sec-items", "kind": "Section", "title": "商品（{cart.itemCount} 件）", "gap": "space.3",
                "children": [
                  { "id": "stock-warning", "kind": "ListItem", "if": "hasUnavailable",
                    "leadingIcon": "warning",
                    "title": "{cart.unavailableCount} 件商品缺货",
                    "detail": "移除后即可提交订单" },
                  {
                    "id": "items", "kind": "List", "gap": "space.4", "each": "cart.items",
                    "item": {
                      "id": "item-{index}", "kind": "Row", "gap": "space.3",
                      "children": [
                        { "id": "item-{index}-photo", "kind": "Thumb", "image": "{item.image}" },
                        { "id": "item-{index}-info", "kind": "Stack", "gap": "space.1",
                          "children": [
                            { "id": "item-{index}-name", "kind": "Text", "text": "{item.name}", "maxLines": 2 },
                            { "id": "item-{index}-variant", "kind": "Text", "text": "{item.variant}", "font": "font.caption", "color": "color.textSecondary" },
                            { "id": "item-{index}-price", "kind": "Text", "text": "{item.lineTotal|money}", "font": "font.subhead" },
                            { "id": "item-{index}-oos", "kind": "Badge", "if": "!item.inStock", "text": "缺货" }
                          ] }
                      ],
                      "trailing": [
                        { "id": "item-{index}-qty", "kind": "Stepper", "if": "item.inStock", "bind": "item.quantity" },
                        { "id": "item-{index}-remove", "kind": "Button", "if": "!item.inStock", "variant": "secondary", "size": "small", "text": "移除",
                          "on": { "tap": { "remove": "item", "with": { "id": "{item.id}" } } } }
                      ]
                    }
                  }
                ]
              },
              {
                "id": "sec-delivery", "kind": "Section", "title": "配送方式", "gap": "space.2",
                "children": [
                  {
                    "id": "delivery", "kind": "List", "gap": "space.2", "each": "delivery.options",
                    "item": {
                      "id": "delivery-{index}", "kind": "OptionRow",
                      "selected": "{item.selected}",
                      "title": "{item.label}",
                      "detail": "{item.eta}",
                      "price": { "cases": [
                        { "if": "item.free", "then": "免运费" },
                        { "else": "{item.price|money}" }
                      ] },
                      "on": { "tap": { "select": "delivery", "with": { "id": "{item.id}" } } }
                    }
                  }
                ]
              },
              {
                "id": "sec-promo", "kind": "Section", "title": "优惠码", "gap": "space.2",
                "children": [
                  { "id": "promo-entry", "kind": "Row", "if": "!promoApplied", "gap": "space.2",
                    "children": [
                      { "id": "promo-code", "kind": "TextField", "bind": "promo.code", "placeholder": "输入优惠码",
                        "error": { "cases": [
                          { "if": "promoInvalid", "then": "{promo.message}" },
                          { "else": null }
                        ] } },
                      { "id": "promo-apply", "kind": "Button", "variant": "secondary", "text": "使用",
                        "on": { "tap": { "submit": "ApplyPromo" } } }
                    ] },
                  { "id": "promo-applied", "kind": "ListItem", "if": "promoApplied",
                    "leadingIcon": "sell",
                    "title": "{promo.code} 已使用",
                    "detail": "立减 {promo.discount|money}",
                    "trailingIcon": "close",
                    "on": { "tap": { "submit": "RemovePromo" } } }
                ]
              },
              {
                "id": "sec-payment", "kind": "Section", "title": "支付方式", "gap": "space.2",
                "children": [
                  {
                    "id": "payment", "kind": "List", "gap": "space.2", "each": "payment.options",
                    "item": {
                      "id": "pay-{index}", "kind": "OptionRow",
                      "selected": "{item.selected}",
                      "icon": "{item.icon}",
                      "title": "{item.label}",
                      "on": { "tap": { "set": "payment.method", "to": "{item.id}" } }
                    }
                  },
                  { "id": "card-saved", "kind": "ListItem", "if": "cardSaved",
                    "leadingIcon": "credit_card",
                    "title": "Visa •••• {payment.cardLast4}",
                    "detail": "已保存的卡",
                    "trailingIcon": "chevron_right",
                    "on": { "tap": { "open": "sheet-cards" } } },
                  { "id": "card-form", "kind": "FieldGroup", "if": "newCard", "gap": "space.2",
                    "children": [
                      { "id": "card-number", "kind": "TextField", "label": "卡号", "placeholder": "1234 5678 9012 3456",
                        "assumed": "Card fields are drawn here; the real build may use the payment provider's hosted fields" },
                      { "id": "card-row", "kind": "Row", "gap": "space.2",
                        "children": [
                          { "id": "card-expiry", "kind": "TextField", "label": "有效期", "placeholder": "MM / YY" },
                          { "id": "card-cvc", "kind": "TextField", "label": "安全码", "placeholder": "CVC" }
                        ] }
                    ] }
                ]
              },
              {
                "id": "summary-compact", "kind": "Stack", "only": "compact",
                "children": [ { "ref": "summary" } ]
              }
            ]
          },
          {
            "id": "aside", "kind": "Card", "only": "regular", "padding": "space.5", "radius": "radius.md",
            "border": "color.border", "elevation": "elevation.card", "gap": "space.4",
            "sticky": true,
            "children": [
              { "ref": "summary" },
              { "ref": "place-order" },
              { "ref": "place-hint" },
              { "id": "aside-terms", "kind": "Text", "font": "font.caption", "color": "color.textSecondary",
                "text": "提交即表示同意《购买须知》，7 天无理由退货" }
            ]
          }
        ]
      },
      {
        "id": "bar", "kind": "StickyBar", "only": "compact", "padding": [12, 16],
        "children": [
          { "id": "bar-total", "kind": "Stack", "gap": 0,
            "children": [
              { "id": "bar-label", "kind": "Text", "text": "应付合计", "font": "font.caption", "color": "color.textSecondary" },
              { "id": "bar-amount", "kind": "Text", "text": "{summary.total|money}", "font": "font.price" },
              { "ref": "place-hint" }
            ] },
          { "id": "bar-submit", "kind": "Button", "variant": "primary", "text": "提交订单",
            "disabled": "!canPlace",
            "on": { "tap": { "submit": "PlaceOrder" } } }
        ]
      }
    ]
  },

  "phases": {
    "loading": {
      "id": "loading", "kind": "Screen", "children": [
        { "ref": "nav" },
        { "id": "loading-body", "kind": "Stack", "padding": "space.4", "gap": "space.6", "children": [
          { "id": "sk-address", "kind": "Skeleton", "shape": ["line 40%", "line 90%"] },
          { "id": "sk-items", "kind": "Skeleton", "shape": ["line 30%", "line 80%", "line 80%", "line 80%"] },
          { "id": "sk-delivery", "kind": "Skeleton", "shape": ["line 30%", "line 90%", "line 90%"] }
        ] }
      ]
    },
    "error": {
      "id": "error", "kind": "Screen", "children": [
        { "ref": "nav" },
        { "id": "error-state", "kind": "EmptyState", "icon": "cloud_off",
          "title": "订单信息加载失败", "detail": "请检查网络后重试",
          "action": { "id": "error-retry", "kind": "Button", "variant": "primary", "text": "重试",
                      "on": { "tap": { "reload": true } } } }
      ]
    }
  }
}
