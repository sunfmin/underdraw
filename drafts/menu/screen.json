{
  "screen": "RestaurantMenu",
  "title": "店铺菜单",
  "locale": "zh-CN",
  "tokens": "tokens.json",
  "$comment": "A delivery app's restaurant menu: dishes grouped by category, a cart bar, and a bottom sheet to choose a dish's size, add-ons and quantity before adding it.",
  "data": {
    "restaurant": "Restaurant",
    "categories": "Category[] 1..12",
    "sections": "MenuSection[] 1..12",
    "cart": "Cart",
    "customizing": {
      "type": "Customizing?",
      "doc": "The dish whose sheet is open; null while no sheet shows"
    }
  },
  "types": {
    "Restaurant": {
      "name": "string 1..30",
      "rating": "number",
      "eta": {
        "type": "string 1..12",
        "doc": "Delivery time as shown, e.g. 25–35 分钟"
      },
      "deliveryFee": "money"
    },
    "Category": {
      "id": "string",
      "label": "string 1..8",
      "selected": "bool = false"
    },
    "MenuSection": {
      "id": "string",
      "title": "string 1..12",
      "dishes": "Dish[] 1..30"
    },
    "Dish": {
      "id": "string",
      "name": "string 1..30",
      "description": "string ..80",
      "price": {
        "type": "money",
        "doc": "Price of the smallest size"
      },
      "soldOut": "bool = false",
      "inCart": {
        "type": "int 0.. = 0",
        "derived": "how many of this dish are in the cart"
      },
      "inCartLabel": {
        "type": "string = \"\"",
        "derived": "\"×2\" when inCart > 0, else empty"
      }
    },
    "Cart": {
      "count": {
        "type": "int 0..",
        "derived": "items in the cart"
      },
      "total": "money",
      "minimum": {
        "type": "money",
        "doc": "The order minimum for delivery"
      },
      "belowMinimum": {
        "type": "bool = false",
        "derived": "total < minimum"
      },
      "shortBy": {
        "type": "money",
        "derived": "minimum − total, when below it"
      }
    },
    "Customizing": {
      "dishId": "string",
      "name": "string 1..30",
      "description": "string ..80",
      "sizes": "Choice[] 1..5",
      "addOns": "Choice[] ..8",
      "addOnCount": {
        "type": "int 0..",
        "derived": "addOns' length"
      },
      "note": "string ..40",
      "quantity": "int 1..20",
      "sizeChosen": {
        "type": "bool = false",
        "derived": "one size is selected"
      },
      "total": {
        "type": "money",
        "derived": "(size + add-ons) × quantity"
      },
      "adding": "bool = false"
    },
    "Choice": {
      "id": "string",
      "label": "string 1..16",
      "extra": "money",
      "free": {
        "type": "bool = false",
        "derived": "extra is zero"
      },
      "selected": "bool = false"
    }
  },
  "conditions": {
    "hasCart": {
      "when": "cart.count > 0",
      "label": "Cart has items"
    },
    "belowMinimum": {
      "when": "hasCart && cart.belowMinimum",
      "label": "Below order minimum"
    },
    "canCheckout": {
      "when": "hasCart && !cart.belowMinimum",
      "label": "Can check out"
    },
    "sheetOpen": {
      "when": "customizing != null",
      "label": "Dish sheet open"
    },
    "hasAddOns": {
      "when": "sheetOpen && customizing.addOnCount > 0",
      "label": "Dish has add-ons"
    },
    "canAdd": {
      "when": "sheetOpen && customizing.sizeChosen && !customizing.adding",
      "label": "Size chosen"
    },
    "adding": {
      "when": "sheetOpen && customizing.adding",
      "label": "Adding to cart"
    }
  },
  "fixtures": {
