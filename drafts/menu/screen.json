  },
  "components": {
    "nav": {
      "id": "nav",
      "kind": "NavBar",
      "leading": {
        "id": "nav-back",
        "kind": "IconButton",
        "icon": "arrow_back",
        "on": {
          "tap": {
            "back": true
          }
        }
      },
      "trailing": [
        {
          "id": "nav-search",
          "kind": "IconButton",
          "icon": "search",
          "on": {
            "tap": {
              "navigate": "MenuSearch"
            }
          }
        },
        {
          "id": "nav-share",
          "kind": "IconButton",
          "icon": "ios_share",
          "on": {
            "tap": {
              "share": true
            }
          }
        }
      ]
    }
  },
  "root": {
    "id": "menu",
    "kind": "Screen",
    "children": [
      {
        "ref": "nav"
      },
      {
        "id": "header",
        "kind": "Stack",
        "gap": "space.2",
        "padding": [
          0,
          16,
          8,
          16
        ],
        "children": [
          {
            "id": "shop-name",
            "kind": "Text",
            "font": "font.heading",
            "text": "{restaurant.name}"
          },
          {
            "id": "shop-meta",
            "kind": "Text",
            "font": "font.caption",
            "color": "color.textSecondary",
            "text": "★ {restaurant.rating|number:1} · {restaurant.eta} · 配送费 {restaurant.deliveryFee|money}"
          },
          {
            "id": "categories",
            "kind": "ChipRow",
            "each": "categories",
            "item": {
              "id": "cat-{index}",
              "kind": "Chip",
              "text": "{item.label}",
              "selected": "{item.selected}",
              "on": {
                "tap": {
                  "scrollTo": "section-{item.id}"
                }
              }
            }
          }
        ]
      },
      {
        "id": "sections",
        "kind": "Stack",
        "each": "sections",
        "item": {
          "id": "section-{index}",
          "kind": "Stack",
          "children": [
            {
              "id": "section-{index}-head",
              "kind": "Stack",
              "padding": [
                16,
                16,
                8,
                16
              ],
              "children": {
                "id": "section-{index}-title",
                "kind": "Text",
                "font": "font.subhead",
                "color": "color.textSecondary",
                "text": "{item.title}"
              }
            },
            {
              "id": "section-{index}-dishes",
              "kind": "Stack",
              "each": "item.dishes",
              "item": {
                "id": "dish-{item.id}",
                "kind": "DishRow",
                "title": "{item.name}",
                "detail": "{item.description}",
                "price": "{item.price|money}",
                "soldOut": "{item.soldOut}",
                "inCart": "{item.inCartLabel}",
                "disabled": "item.soldOut",
                "on": {
                  "tap": {
                    "open": "dish-sheet",
                    "with": {
                      "id": "{item.id}"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      {
        "id": "cart-bar",
        "kind": "StickyBar",
        "if": "hasCart",
        "padding": [
          12,
          16
        ],
        "sticky": "bottom",
        "children": [
          {
            "id": "cart-summary",
            "kind": "Stack",
            "gap": "space.1",
            "children": [
              {
                "id": "cart-total",
                "kind": "Text",
                "font": "font.price",
                "text": "{cart.total|money}"
              },
              {
                "id": "cart-count",
                "kind": "Text",
                "font": "font.caption",
                "color": "color.textSecondary",
                "text": {
                  "cases": [
                    {
                      "if": "belowMinimum",
                      "then": "还差 {cart.shortBy|money} 起送"
                    },
                    {
                      "else": "共 {cart.count} 件"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "checkout",
            "kind": "Button",
            "variant": "primary",
            "text": "去结算",
            "disabled": "!canCheckout",
            "on": {
              "tap": {
                "navigate": "Checkout"
              }
            }
          }
        ]
      }
    ],
    "overlay": {
      "id": "dish-sheet",
      "kind": "Sheet",
      "if": "sheetOpen",
      "anchor": {
        "compact": "bottom",
        "regular": "center"
      },
      "dismiss": "swipe down or tap the backdrop",
      "children": [
        {
          "id": "ds-head",
          "kind": "Stack",
          "gap": "space.1",
          "children": [
            {
              "id": "ds-name",
              "kind": "Text",
              "font": "font.heading",
              "text": "{customizing.name}"
            },
            {
              "id": "ds-desc",
              "kind": "Text",
              "font": "font.caption",
              "color": "color.textSecondary",
              "text": "{customizing.description}"
            }
          ]
        },
        {
          "id": "ds-sizes",
          "kind": "Section",
          "title": "规格",
          "subtitle": "必选 · 选 1 项",
          "gap": "space.1",
          "children": {
            "id": "ds-size-list",
            "kind": "Stack",
            "each": "customizing.sizes",
            "item": {
              "id": "size-{item.id}",
              "kind": "ChoiceRow",
              "text": "{item.label}",
              "icon": {
                "cases": [
                  {
                    "if": "item.selected",
                    "then": "radio_button_checked"
                  },
                  {
                    "else": "radio_button_unchecked"
                  }
                ]
              },
              "detail": {
                "cases": [
                  {
                    "if": "item.free",
                    "then": ""
                  },
                  {
                    "else": "+{item.extra|money}"
                  }
                ]
              },
              "on": {
                "tap": {
                  "set": "size",
                  "to": "{item.id}"
                }
              }
            }
          }
        },
        {
          "id": "ds-addons",
          "kind": "Section",
          "if": "hasAddOns",
          "title": "加料",
          "subtitle": "可多选",
          "gap": "space.1",
          "children": {
            "id": "ds-addon-list",
            "kind": "Stack",
            "each": "customizing.addOns",
            "item": {
              "id": "addon-{item.id}",
              "kind": "ChoiceRow",
              "text": "{item.label}",
              "icon": {
                "cases": [
                  {
                    "if": "item.selected",
                    "then": "check_box"
                  },
                  {
                    "else": "check_box_outline_blank"
                  }
                ]
              },
              "detail": {
                "cases": [
                  {
                    "if": "item.free",
                    "then": "免费"
                  },
                  {
                    "else": "+{item.extra|money}"
                  }
                ]
              },
              "on": {
                "tap": {
                  "toggle": "item.selected"
                }
              }
            }
          }
        },
        {
          "id": "ds-note",
          "kind": "NoteField",
          "bind": "customizing.note",
          "placeholder": "给厨房留言（选填）"
        },
        {
          "id": "ds-actions",
          "kind": "Row",
          "gap": "space.3",
          "children": [
            {
              "id": "ds-quantity",
              "kind": "Stepper",
              "bind": "customizing.quantity",
              "min": 1,
              "max": 20
            },
            {
              "id": "ds-add",
              "kind": "Button",
              "variant": "primary",
              "disabled": "!canAdd",
              "text": {
                "cases": [
                  {
                    "if": "adding",
                    "then": "正在加入…"
                  },
                  {
                    "else": "加入购物车 {customizing.total|money}"
                  }
                ]
              },
              "on": {
                "tap": {
                  "submit": "addToCart",
                  "with": {
                    "id": "{customizing.dishId}"
                  }
                }
              }
            }
          ]
        }
      ],
      "width": {
        "compact": "100%",
        "regular": 520
      },
      "handle": {
        "compact": true,
        "regular": false
      }
    }
  },
  "phases": {
    "loading": {
      "id": "loading",
      "kind": "Screen",
      "children": [
        {
          "ref": "nav"
        },
        {
          "id": "sk",
          "kind": "Stack",
          "padding": 16,
          "children": [
            {
              "id": "sk-lines",
              "kind": "Skeleton",
              "shape": [
                "line 60%",
                "line 40%",
                "line 100%",
                "image 4:3",
                "line 90%",
                "line 70%"
              ]
            }
          ]
        }
      ]
    },
    "error": {
      "id": "error",
      "kind": "Screen",
      "children": [
        {
          "ref": "nav"
        },
        {
          "id": "err",
          "kind": "EmptyState",
          "icon": "cloud_off",
          "title": "菜单加载失败",
          "detail": "检查网络后重试",
          "action": {
            "id": "retry",
            "kind": "Button",
            "text": "重试",
            "on": {
              "tap": {
                "reload": true
              }
            }
          }
        }
      ]
    }
  }
}