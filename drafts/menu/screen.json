          }
        ],
        "addOns": [
          {
            "id": "egg",
            "label": "溏心蛋",
            "extra": {
              "amount": 120,
              "currency": "JPY"
            },
            "selected": true
          },
          {
            "id": "chashu",
            "label": "加叉烧",
            "extra": {
              "amount": 250,
