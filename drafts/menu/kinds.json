{
  "kinds": {
    "Chip": {
      "doc": "A menu category as a pill: filled when it is the one in view.",
      "look": {
        "box": "row",
        "padding": [
          6,
          12
        ],
        "radius": 999,
        "shrink": 0,
        "fill": {
          "cases": [
            {
              "if": "selected",
              "then": "strong"
            },
            {
              "else": null
            }
          ]
        },
        "stroke": {
          "cases": [
            {
              "if": "selected",
              "then": null
            },
            {
              "else": "line"
            }
          ]
        },
        "children": [
          {
            "text": "{text}",
            "font": "font.caption",
            "maxLines": 1,
            "ink": {
              "cases": [
                {
                  "if": "selected",
                  "then": "paper"
                },
                {
                  "else": "text"
                }
              ]
            }
          }
        ]
      }
    },
    "ChipRow": {
      "doc": "Category chips in one row that scrolls sideways.",
      "look": {
        "box": "row",
        "gap": 8,
        "overflowX": "clip",
        "frame": true,
        "children": [
          "$children"
        ]
      }
    },
    "DishRow": {
      "doc": "One dish: name, a two-line description and the price on the left, its photo on the right; sold out dims it and says so.",
      "look": {
        "box": "row",
        "gap": 12,
        "padding": [
          12,
          16
        ],
        "topLine": "line",
        "children": [
          {
            "box": "column",
            "gap": 4,
            "grow": 1,
            "shrink": 1,
            "children": [
              {
                "text": "{title}",
                "font": "font.subhead",
                "ink": {
                  "cases": [
                    {
                      "if": "soldOut",
                      "then": "muted"
                    },
                    {
                      "else": "text"
                    }
                  ]
                }
              },
              {
                "text": "{detail}",
                "font": "font.caption",
                "ink": "muted",
                "maxLines": 2
              },
              {
                "box": "row",
                "gap": 8,
                "items": "center",
                "children": [
                  {
                    "text": "{price}",
                    "font": "font.subhead"
                  },
                  {
                    "if": "soldOut",
                    "box": "row",
                    "padding": [
                      2,
                      8
                    ],
                    "radius": 999,
                    "stroke": "line",
                    "children": [
                      {
                        "text": "已售罄",
                        "font": "font.caption",
                        "ink": "muted"
                      }
                    ]
                  },
                  {
                    "if": "inCart != \"\"",
                    "box": "row",
                    "padding": [
                      2,
                      8
                    ],
                    "radius": 999,
                    "fill": "strong",
                    "children": [
                      {
                        "text": "{inCart}",
                        "font": "font.caption",
                        "ink": "paper"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "box": "column",
            "size": 88,
            "radius": 8,
            "cross": "line",
            "shrink": 0
          }
        ]
      }
    },
    "Sheet": {
      "doc": "On a phone, a bottom sheet: full width, a grab handle, swipe down or tap the backdrop to close. On a wide screen, the same content as a centred dialog. Both over a dimmed backdrop.",
      "look": {
        "box": "column",
        "backdrop": true,
        "width": "{width|or:100%}",
        "gap": 16,
        "padding": [
          8,
          16,
          24,
          16
        ],
        "radius": 16,
        "fill": "paper",
        "stroke": "line",
        "children": [
          {
            "box": "row",
            "justify": "center",
            "children": [
              {
                "box": "row",
                "width": 40,
                "height": 4,
                "radius": 2,
                "fill": "line"
              }
            ],
            "if": "handle"
          },
          "$children"
        ]
      }
    },
    "ChoiceRow": {
      "doc": "One choice in a sheet's option group: a radio (single choice) or a checkbox (several), its label, and what it adds to the price.",
      "look": {
        "box": "row",
        "gap": 12,
        "padding": [
          10,
          0
        ],
        "items": "center",
        "children": [
          {
            "kind": "Glyph",
            "icon": "{icon}",
            "size": 22
          },
          {
            "box": "row",
            "grow": 1,
            "children": [
              {
                "text": "{text}"
              }
            ]
          },
          {
            "text": "{detail}",
            "font": "font.caption",
            "ink": "muted"
          }
        ]
      }
    },
    "NoteField": {
      "doc": "A one-line note to the kitchen; shows the note, or the placeholder when empty.",
      "look": {
        "box": "row",
        "padding": [
          10,
          12
        ],
        "radius": 8,
        "stroke": "line",
        "children": [
          {
            "text": "{placeholder}",
            "ink": "muted",
            "if": "value == \"\""
          },
          {
            "text": "{value}",
            "if": "value != \"\""
          }
        ]
      }
    }
  }
}