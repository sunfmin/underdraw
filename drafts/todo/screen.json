{
  "screen": "TodoList",
  "title": "待办清单",
  "locale": "zh-CN",
  "tokens": "tokens.json",
  "data": {
    "todos": "Todo[] ..200",
    "summary": "Summary",
    "composer": "Composer"
  },
  "types": {
    "Todo": {
      "id": "string",
      "title": "string 1..80",
      "done": "bool = false"
    },
    "Summary": {
      "total": {
        "type": "int 0..",
        "derived": "todos 的条数"
      },
      "remaining": {
        "type": "int 0..",
        "derived": "未完成的条数"
      },
      "completed": {
        "type": "int 0..",
        "derived": "已完成的条数"
      }
    },
    "Composer": {
      "text": "string ..80 = \"\"",
      "canSubmit": {
        "type": "bool",
        "derived": "去掉首尾空白后非空"
      }
    }
  },
  "conditions": {
    "hasTodos": {
      "when": "summary.total > 0",
      "label": "有待办"
    },
    "allDone": {
      "when": "hasTodos && summary.remaining == 0",
      "label": "全部完成"
    },
    "hasCompleted": {
      "when": "summary.completed > 0",
      "label": "有已完成的"
    },
    "canAdd": {
      "when": "composer.canSubmit",
      "label": "可以添加"
    }
  },
  "fixtures": {
    "default": {
      "todos": [
        {
          "id": "1",
          "title": "买牛奶",
          "done": true
        },
        {
          "id": "2",
          "title": "给房东回邮件，确认下个月的入住时间"
        },
        {
          "id": "3",
          "title": "周五前交季度报告"
        }
      ],
      "summary": {
        "total": 3,
        "remaining": 2,
        "completed": 1
      },
      "composer": {
        "canSubmit": false
      }
    },
    "typing": {
      "$patch": "default",
      "composer": {
        "text": "取快递",
        "canSubmit": true
      }
    },
    "all-done": {
      "todos": [
        {
          "id": "1",
          "title": "买牛奶",
          "done": true
        },
        {
          "id": "2",
          "title": "交报告",
          "done": true
        }
      ],
      "summary": {
        "total": 2,
        "remaining": 0,
        "completed": 2
      },
      "composer": {
        "canSubmit": false
      }
    },
    "empty": {
      "todos": [],
      "summary": {
        "total": 0,
        "remaining": 0,
        "completed": 0
      },
      "composer": {
        "canSubmit": false
      }
    }
  },
  "root": {
    "id": "todo-screen",
    "kind": "Screen",
    "children": [
      {
        "id": "header",
        "kind": "Stack",
        "gap": "space.1",
        "padding": "space.4",
        "children": [
          {
            "id": "header-title",
            "kind": "Text",
            "text": "我的待办",
            "font": "font.title"
          },
          {
            "id": "header-count",
            "kind": "Text",
            "if": "hasTodos",
            "font": "font.caption",
            "color": "color.textSecondary",
            "text": {
              "cases": [
                {
                  "if": "allDone",
                  "then": "全部完成了"
                },
                {
                  "else": "还剩 {summary.remaining} 项"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "composer",
        "kind": "Row",
        "gap": "space.3",
        "padding": "space.4",
        "children": [
          {
            "id": "composer-input",
            "kind": "TextField",
            "bind": "composer.text",
            "placeholder": "添加一项待办…"
          },
          {
            "id": "composer-add",
            "kind": "Button",
            "variant": "primary",
            "text": "添加",
            "disabled": "!canAdd",
            "on": {
              "tap": {
                "set": "composer.text",
                "to": ""
              }
            }
          }
        ]
      },
      {
        "id": "divider",
        "kind": "Divider"
      },
      {
        "id": "todo-empty",
        "kind": "EmptyState",
        "if": "!hasTodos",
        "icon": "checklist",
        "title": "还没有待办",
        "detail": "在上面输入一项，点「添加」。"
      },
      {
        "id": "todo-list",
        "kind": "List",
        "if": "hasTodos",
        "each": "todos",
        "item": {
          "id": "todo-{index}",
          "kind": "ListItem",
          "title": "{item.title}",
          "leadingIcon": {
            "cases": [
              {
                "if": "item.done",
                "then": "checkmark.circle.fill"
              },
              {
                "else": "circle"
              }
            ]
          },
          "on": {
            "tap": {
              "toggle": "item.done"
            }
          }
        }
      },
      {
        "id": "clear-completed",
        "kind": "Link",
        "if": "hasCompleted",
        "text": "清除已完成（{summary.completed}）"
      }
    ]
  },
  "phases": {
    "loading": {
      "id": "todo-loading",
      "kind": "Screen",
      "children": [
        {
          "id": "loading-skeleton",
          "kind": "Skeleton",
          "shape": [
            "line 40%",
            "line 90%",
            "line 90%",
            "line 90%"
          ]
        }
      ]
    }
  }
}