{
  "kinds": {
    "SearchField": {
      "doc": "One part of the search on a desktop: a small label over what was searched; it shares the row with the others.",
      "look": {
        "box": "column",
        "gap": 2,
        "padding": [
          8,
          12
        ],
        "grow": 1,
        "basis": 0,
        "stroke": "line",
        "radius": "radius.sm",
        "children": [
          {
            "text": "{label}",
            "font": "font.caption",
            "ink": "muted"
          },
          {
            "text": "{value}",
            "font": "font.subhead",
            "maxLines": 1
          }
        ]
      }
    },
    "DayPrice": {
      "doc": "A day near the searched date, with its lowest fare; the searched day is filled.",
      "look": {
        "box": "column",
        "gap": 2,
        "items": "center",
        "padding": [
          8,
          0
        ],
        "width": 96,
        "shrink": 0,
        "radius": "radius.sm",
        "fill": {
          "cases": [
            {
              "if": "selected",
              "then": "fill"
            },
            {
              "else": null
            }
          ]
        },
        "stroke": {
          "cases": [
            {
              "if": "selected",
              "then": "text"
            },
            {
              "else": "line"
            }
          ]
        },
        "children": [
          {
            "text": "{date}",
            "font": "font.caption",
            "ink": "muted"
          },
          {
            "text": "{price}",
            "font": "font.subhead"
          }
        ]
      }
    },
    "SortTab": {
      "doc": "One way to order the results, with the best fare under it; the chosen one is outlined and filled.",
      "look": {
        "box": "column",
        "gap": 2,
        "grow": 1,
        "basis": 0,
        "padding": [
          10,
          8
        ],
        "radius": "radius.sm",
        "fill": {
          "cases": [
            {
              "if": "selected",
              "then": "fill"
            },
            {
              "else": null
            }
          ]
        },
        "stroke": {
          "cases": [
            {
              "if": "selected",
              "then": "text"
            },
            {
              "else": "line"
            }
          ]
        },
        "children": [
          {
            "text": "{label}",
            "font": "font.subhead"
          },
          {
            "text": "{detail}",
            "font": "font.caption",
            "ink": "muted",
            "maxLines": 1
          }
        ]
      }
    },
    "Chip": {
      "doc": "A filter as a pill: filled dark when on; a ▾ when it opens a menu; a count when some of its options are on.",
      "look": {
        "box": "row",
        "gap": 6,
        "padding": [
          6,
          12
        ],
        "shrink": 0,
        "radius": 999,
        "fill": {
          "cases": [
            {
              "if": "selected",
              "then": "strong"
            },
            {
              "else": null
            }
          ]
        },
        "stroke": {
          "cases": [
            {
              "if": "selected",
              "then": null
            },
            {
              "else": "line"
            }
          ]
        },
        "children": [
          {
            "text": {
              "cases": [
                {
                  "if": "menu",
                  "then": "{text} ▾"
                },
                {
                  "else": "{text}"
                }
              ]
            },
            "font": "font.caption",
            "ink": {
              "cases": [
                {
                  "if": "selected",
                  "then": "paper"
                },
                {
                  "else": "text"
                }
              ]
            }
          }
        ]
      }
    },
    "Checkbox": {
      "doc": "A filter option: box, name, and on the right the lowest fare with it.",
      "look": {
        "box": "row",
        "gap": 10,
        "padding": [
          6,
          0
        ],
        "children": [
          {
            "box": "row",
            "justify": "center",
            "size": 18,
            "shrink": 0,
            "radius": 4,
            "fill": {
              "cases": [
                {
                  "if": "checked",
                  "then": "strong"
                },
                {
                  "else": null
                }
              ]
            },
            "stroke": {
              "cases": [
                {
                  "if": "checked",
                  "then": null
                },
                {
                  "else": "text"
                }
              ]
            },
            "children": [
              {
                "if": "checked",
                "text": "✓",
                "font": "font.caption",
                "ink": "paper"
              }
            ]
          },
          {
            "box": "row",
            "grow": 1,
            "shrink": 1,
            "children": [
              {
                "text": "{label}",
                "font": "font.body"
              }
            ]
          },
          {
            "if": "detail",
            "text": "{detail}",
            "font": "font.caption",
            "ink": "muted"
          }
        ]
      }
    },
    "Route": {
      "doc": "A flight's times end to end: departure on the left, arrival on the right, a line between them carrying the duration over it and the stops under it.",
      "look": {
        "box": "row",
        "gap": 8,
        "grow": 1,
        "shrink": 1,
        "children": [
          {
            "box": "column",
            "items": "start",
            "children": [
              {
                "text": "{depart}",
                "font": "font.time"
              },
              {
                "text": "{departCode}",
                "font": "font.caption",
                "ink": "muted"
              }
            ]
          },
          {
            "box": "column",
            "gap": 4,
            "grow": 1,
            "shrink": 1,
            "items": "center",
            "children": [
              {
                "text": "{duration}",
                "font": "font.caption",
                "ink": "muted"
              },
              {
                "width": "100%",
                "height": 1,
                "fill": "line"
              },
              {
                "text": "{stops}",
                "font": "font.caption",
                "ink": {
                  "cases": [
                    {
                      "if": "nonstop",
                      "then": "text"
                    },
                    {
                      "else": "muted"
                    }
                  ]
                }
              }
            ]
          },
          {
            "box": "column",
            "items": "start",
            "children": [
              {
                "box": "row",
                "gap": 2,
                "children": [
                  {
                    "text": "{arrive}",
                    "font": "font.time"
                  },
                  {
                    "if": "nextDay",
                    "text": "+1",
                    "font": "font.caption"
                  }
                ]
              },
              {
                "text": "{arriveCode}",
                "font": "font.caption",
                "ink": "muted"
              }
            ]
          }
        ]
      }
    },
    "Tag": {
      "doc": "A short word that marks a flight out (最便宜, 最快).",
      "look": {
        "self": "start",
        "padding": [
          2,
          8
        ],
        "radius": 4,
        "fill": "fill",
        "children": [
          {
            "text": "{text}",
            "font": "font.caption",
            "weight": 600
          }
        ]
      }
    },
    "Strip": {
      "doc": "A row that runs off the edge: what does not fit scrolls into view.",
      "look": {
        "box": "row",
        "gap": "{gap|or:8}",
        "overflowX": "clip",
        "clip": 0,
        "frame": true,
        "children": [
          "$children"
        ]
      }
    }
  }
}
