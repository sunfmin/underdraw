{
  "screen": "DocumentList",
  "title": "团队文档",
  "locale": "zh-CN",
  "tokens": "tokens.json",
  "$comment": "A team's documents: sorted by a dropdown in the toolbar, each row with a ⋯ menu of actions.",
  "data": {
    "summary": "Summary",
    "sort": "Sort",
    "docs": "Doc[] ..50",
    "rowMenu": {
      "type": "RowMenu?",
      "doc": "The document whose ⋯ menu is open; null while it is closed"
    }
  },
  "types": {
    "Summary": {
      "count": {
        "type": "int 0..",
        "derived": "docs' length"
      }
    },
    "Sort": {
      "label": {
        "type": "string 1..8",
        "derived": "the selected option's label"
      },
      "menuOpen": "bool = false",
      "options": "SortOption[] 2..6"
    },
    "SortOption": {
      "id": "string",
      "label": "string 1..8",
      "selected": "bool = false"
    },
    "Doc": {
      "id": "string",
      "title": "string 1..60",
      "icon": {
        "type": "icon",
        "doc": "description / table_chart / slideshow, by the document's type"
      },
      "owner": "string 1..20",
      "updated": "date",
      "shared": "bool = false",
      "menuOpen": {
        "type": "bool = false",
        "derived": "rowMenu is open on this document"
      }
    },
    "RowMenu": {
      "docId": "string",
      "canDelete": {
        "type": "bool = false",
        "derived": "the person owns the document"
      }
    }
  },
  "conditions": {
    "hasDocs": {
      "when": "summary.count > 0",
      "label": "Has documents"
    },
    "sortOpen": {
      "when": "sort.menuOpen",
      "label": "Sort menu open"
    },
    "rowMenuOpen": {
      "when": "rowMenu != null",
      "label": "A row's menu is open"
    },
    "canDelete": {
      "when": "rowMenuOpen && rowMenu.canDelete",
      "label": "May delete it"
    }
  },
