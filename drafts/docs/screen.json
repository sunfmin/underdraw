  "components": {
    "Nav": {
      "nodes": {
        "component": "NavBar",
        "children": {
          "id": "title",
          "component": "Text",
          "text": "团队文档",
          "font": "font.heading"
        },
        "trailing": {
          "id": "new",
          "component": "IconButton",
          "icon": "add",
          "on": {
            "tap": {
              "call": "newDocument"
            }
          }
        }
      }
    },
    "SortButton": {
    "doc": "The sort control: the current order and a chevron; it opens the sort menu.",
    "params": ["text", "trailingIcon"],
    "look": { "box": "row", "gap": 4, "padding": [6, 8, 6, 12], "radius": 8, "stroke": "line", "items": "center", "children": [
      { "text": "{text}", "font": "font.caption" },
      { "component": "Glyph", "icon": "{trailingIcon|or:expand_more}", "size": 18 } ] } },
    "DocRow": {
    "doc": "One document: its type icon, title, who owns it and when it changed, a shared badge, then the row's slots (its ⋯ button, and its menu when open).",
    "params": ["leadingIcon", "title", "shared", "detail"],
    "look": { "box": "row", "gap": 12, "padding": [12, 8, 12, 16], "topLine": "line", "items": "center", "children": [
      { "component": "Glyph", "icon": "{leadingIcon}", "size": 28 },
      { "box": "column", "gap": 2, "grow": 1, "shrink": 1, "children": [
        { "box": "row", "gap": 8, "items": "center", "children": [
          { "text": "{title}", "font": "font.subhead", "maxLines": 1 },
          { "if": "shared", "box": "row", "padding": [1, 6], "radius": 999, "stroke": "line",
            "children": [ { "text": "共享", "font": "font.caption", "ink": "muted" } ] } ] },
        { "text": "{detail}", "font": "font.caption", "ink": "muted", "maxLines": 1 } ] },
      "$children" ] } },
    "Menu": {
    "doc": "A dropdown menu: a raised panel of items under the control that opened it; tapping outside or choosing an item closes it. No backdrop.",
    "params": ["width"],
    "look": { "box": "column", "width": "{width|or:220}", "padding": [4, 0], "radius": 8,
              "fill": "paper", "stroke": "line", "children": ["$children"] } },
    "MenuItem": {
    "doc": "One menu item: an icon, its label, and a check when it is the current choice. A destructive item is shown in the danger colour.",
    "params": { "leadingIcon": "icon?", "text": "string", "disabled": "bool = false", "selected": "bool = false" },
    "look": { "box": "row", "gap": 12, "padding": [10, 16], "items": "center", "children": [
      { "if": "leadingIcon", "component": "Glyph", "icon": "{leadingIcon}", "size": 20 },
      { "box": "row", "grow": 1, "children": [
        { "text": "{text}", "ink": { "cases": [ { "if": "disabled", "then": "muted" }, { "else": "text" } ] } } ] },
      { "if": "selected", "component": "Glyph", "icon": "check", "size": 20 } ] } },
    "Dialog": {
    "doc": "A modal dialog centred over a dimmed backdrop; it blocks the screen until dismissed.",
    "params": ["width"],
    "look": { "box": "column", "backdrop": true, "width": "{width|or:88%}", "gap": 16, "padding": 24,
              "radius": 16, "fill": "paper", "stroke": "line", "children": ["$children"] } },
    "Checkbox": {
    "doc": "A box that picks its row, to act on several at once: ticked while checked.",
    "params": ["checked"],
    "look": { "box": "row", "padding": 4, "items": "center", "children": [
      { "component": "Glyph", "icon": { "cases": [ { "if": "checked", "then": "check_box" }, { "else": "check_box_outline_blank" } ] }, "size": 22 } ] } },
    "MenuDivider": {
    "doc": "A line between groups of menu items.",
    "params": [],
    "look": { "box": "row", "height": 1, "margin": [4, 0], "fill": "line" } }
  },
  "root": {
    "id": "docs",
    "component": "Screen",
    "children": [
      { "id": "nav", "component": "Nav" },
      {
        "id": "toolbar",
        "component": "Row",
        "gap": 12,
        "padding": [
          0,
          16,
          8,
          16
        ],
        "children": [
          {
            "id": "doc-count",
            "component": "Text",
            "font": "font.caption",
            "color": "color.textSecondary",
            "text": "共 {summary.count} 个文档"
          },
          {
            "id": "selected-count",
            "component": "Text",
            "if": "hasSelection",
            "font": "font.caption",
            "text": "已选 {selection.count} 个"
          },
          {
            "id": "delete-selected",
            "component": "Button",
            "size": "small",
            "variant": "secondary",
            "text": "删除所选",
            "disabled": "!hasSelection",
            "$why": "greyed while nothing is picked, so the person learns it is there; it only asks, as deleting cannot be undone",
            "on": {
              "tap": {
                "open": "confirm-delete-selected"
              }
            }
          }
        ],
        "trailing": {
          "id": "sort-button",
          "component": "SortButton",
          "text": "排序：{sort.label}",
          "trailingIcon": {
            "cases": [
              {
                "if": "sortOpen",
                "then": "expand_less"
              },
              {
                "else": "expand_more"
              }
            ]
          },
          "on": {
            "tap": {
              "toggle": "sort.menuOpen"
            }
          }
        }
      },
      {
        "id": "list",
        "component": "Stack",
        "if": "hasDocs",
        "each": "docs",
        "item": {
          "id": "doc-{item.doc.id}",
          "component": "DocRow",
          "leadingIcon": "{item.doc.icon}",
          "title": "{item.doc.title}",
          "shared": "{item.doc.shared}",
          "detail": "{item.doc.owner} · {item.doc.updated|date}",
          "on": {
            "tap": {
              "navigate": "Document",
              "with": {
                "id": "{item.doc.id}"
              }
            }
          },
          "trailing": [
            {
              "id": "doc-{item.doc.id}-select",
              "component": "Checkbox",
              "checked": "{item.selected}",
              "on": {
                "tap": {
                  "toggle": "item.selected"
                }
              }
            },
            {
              "id": "doc-{item.doc.id}-more",
              "component": "IconButton",
              "icon": "more_horiz",
              "on": {
                "tap": {
                  "open": "row-menu",
                  "with": {
                    "id": "{item.doc.id}"
                  }
                }
              }
            }
          ],
          "overlay": {
            "id": "doc-{item.doc.id}-menu",
            "component": "Menu",
            "if": "item.menuOpen",
            "anchor": "top-trailing",
            "dismiss": "tap outside or choose an item",
            "children": [
              {
                "id": "doc-{item.doc.id}-rename",
                "component": "MenuItem",
                "leadingIcon": "edit",
                "text": "重命名",
                "on": {
                  "tap": {
                    "open": "rename-dialog",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              },
              {
                "id": "doc-{item.doc.id}-copy",
                "component": "MenuItem",
                "leadingIcon": "link",
                "text": "复制链接",
                "on": {
                  "tap": {
                    "copy": "Document",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              },
              {
                "id": "doc-{item.doc.id}-move",
                "component": "MenuItem",
                "leadingIcon": "drive_file_move",
                "text": "移动到…",
                "on": {
                  "tap": {
                    "navigate": "MoveDocument",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              },
              {
                "id": "doc-{item.doc.id}-divider",
                "component": "MenuDivider"
              },
              {
                "id": "doc-{item.doc.id}-delete",
                "component": "MenuItem",
                "leadingIcon": "delete",
                "text": "删除",
                "destructive": true,
                "disabled": "!canDelete",
                "$why": "only the owner may delete; others see it greyed so they know it exists",
                "on": {
                  "tap": {
                    "open": "confirm-delete",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              }
            ]
          }
        },
        "overlay": {
          "id": "sort-menu",
          "component": "Menu",
          "if": "sortOpen",
          "anchor": "top-trailing",
          "width": 180,
          "dismiss": "tap outside or choose an option",
          "children": {
            "id": "sort-options",
            "component": "Stack",
            "each": "sort.options",
            "item": {
              "id": "sort-{item.id}",
              "component": "MenuItem",
              "text": "{item.label}",
              "selected": "{item.selected}",
              "on": {
                "tap": {
                  "call": "listDocs",
                  "with": {
                    "sort": "{item.id}",
                    "cursor": null
                  }
                }
              }
            }
          }
        }
      },
      {
        "id": "load-more",
        "component": "Button",
        "if": "hasMore",
        "text": "加载更多",
        "on": {
          "tap": {
            "call": "listDocs",
            "with": {
              "cursor": "{next}"
            }
          }
        }
      },
      {
        "id": "empty",
        "component": "EmptyState",
        "if": "!hasDocs",
        "icon": "folder_open",
        "title": "还没有文档",
        "detail": "新建一个，或者把文件拖到这里",
        "action": {
          "id": "empty-new",
          "component": "Button",
          "text": "新建文档",
          "on": {
            "tap": {
              "call": "newDocument"
            }
          }
        }
      }
    ],
    "overlay": [
      {
        "id": "confirm-delete",
        "component": "Dialog",
        "if": "confirmingDelete",
        "anchor": "center",
        "width": {
          "compact": "88%",
          "regular": 400
      },
      "$why": "deleting is for everyone and cannot be undone, so the menu item only asks; this button deletes",
      "children": [
        {
          "id": "confirm-delete-title",
          "component": "Text",
          "text": "删除这个文档？",
          "font": "font.heading"
        },
        {
          "id": "confirm-delete-detail",
          "component": "Text",
          "text": "团队里的所有人都将无法再打开它，删除后无法恢复。",
          "color": "color.textSecondary"
        },
        {
          "id": "confirm-delete-actions",
          "component": "Row",
          "gap": 12,
          "children": [
            {
              "id": "confirm-delete-cancel",
              "component": "Button",
              "variant": "secondary",
              "text": "取消",
              "on": {
                "tap": {
                  "close": "confirm-delete"
                }
              }
            },
            {
              "id": "confirm-delete-confirm",
              "component": "Button",
              "variant": "primary",
              "destructive": true,
              "text": "删除",
              "on": {
                "tap": {
                  "call": "deleteDoc",
                  "with": {
                    "id": "{rowMenu.docId}"
                  }
                }
              }
            }
          ]
        }
      ]
      },
      {
        "id": "confirm-delete-selected",
        "component": "Dialog",
        "if": "confirmingDeleteSelected",
        "anchor": "center",
        "width": {
          "compact": "88%",
          "regular": 400
        },
        "$why": "deletes every picked document at once, for everyone, and cannot be undone; one the person does not own is left, and the result says so",
        "children": [
          {
            "id": "confirm-delete-selected-title",
            "component": "Text",
            "text": "删除所选的 {selection.count} 个文档？",
            "font": "font.heading"
          },
          {
            "id": "confirm-delete-selected-detail",
            "component": "Text",
            "text": "团队里的所有人都将无法再打开它们，删除后无法恢复。",
            "color": "color.textSecondary"
          },
          {
            "id": "confirm-delete-selected-actions",
            "component": "Row",
            "gap": 12,
            "children": [
              {
                "id": "confirm-delete-selected-cancel",
                "component": "Button",
                "variant": "secondary",
                "text": "取消",
                "on": {
                  "tap": {
                    "close": "confirm-delete-selected"
                  }
                }
              },
              {
                "id": "confirm-delete-selected-confirm",
                "component": "Button",
                "variant": "primary",
                "destructive": true,
                "text": "删除",
                "on": {
                  "tap": {
                    "call": "deleteDocs",
                    "with": {
                      "ids": "{selection.ids}"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "phases": {
    "loading": {
      "id": "loading",
      "component": "Screen",
      "children": [
        { "id": "nav", "component": "Nav" },
        {
          "id": "sk",
          "component": "Stack",
          "padding": 16,
          "children": [
            {
              "id": "sk-lines",
              "component": "Skeleton",
              "shape": [
                "line 30%",
                "line 90%",
                "line 60%",
                "line 90%",
                "line 60%",
                "line 90%",
                "line 60%"
              ]
            }
          ]
        }
      ]
    },
    "error": {
      "id": "error",
      "component": "Screen",
      "children": [
        { "id": "nav", "component": "Nav" },
        {
          "id": "err",
          "component": "EmptyState",
          "icon": "cloud_off",
          "title": "文档加载失败",
          "detail": "检查网络后重试",
          "action": {
            "id": "retry",
            "component": "Button",
            "text": "重试",
            "on": {
              "tap": {
                "call": "listDocs",
                "with": {
                  "sort": "updated",
                  "cursor": null
                }
              }
            }
          }
        }
      ]
    }
  },
  "transitions": [
    { "from": "default", "on": "sort-button.tap", "to": "sort-open" },
    { "from": "sort-open", "on": "sort-{item.id}.tap", "outcome": "ok", "to": "default" },
    { "from": "default", "on": "doc-{item.doc.id}-more.tap", "to": "row-menu-own" },
    { "from": "row-menu-own", "on": "doc-{item.doc.id}-delete.tap", "to": "confirm-delete" },
    { "from": "confirm-delete", "on": "confirm-delete-cancel.tap", "to": "default" },
    { "from": "confirm-delete", "on": "confirm-delete-confirm.tap", "outcome": "ok", "to": "default" },
    { "from": "confirm-delete", "on": "confirm-delete-confirm.tap", "outcome": "notFound", "to": "default" },
    { "from": "default", "on": "doc-{item.doc.id}-select.tap", "to": "some-selected" },
    { "from": "some-selected", "on": "delete-selected.tap", "to": "confirm-delete-selected" },
    { "from": "confirm-delete-selected", "on": "confirm-delete-selected-cancel.tap", "to": "some-selected" },
    { "from": "confirm-delete-selected", "on": "confirm-delete-selected-confirm.tap", "outcome": "ok", "to": "default" },
    { "from": "more-to-come", "on": "load-more.tap", "outcome": "ok", "to": "default" },
    { "from": "error", "on": "retry.tap", "outcome": "ok", "to": "default" },
    { "from": "error", "on": "retry.tap", "outcome": "offline", "to": "error" }
  ]
}
