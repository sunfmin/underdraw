  "components": {
    "nav": {
      "id": "nav",
      "kind": "NavBar",
      "children": {
        "id": "nav-title",
        "kind": "Text",
        "text": "团队文档",
        "font": "font.heading"
      },
      "trailing": {
        "id": "nav-new",
        "kind": "IconButton",
        "icon": "add",
        "on": {
          "tap": {
            "call": "newDocument"
          }
        }
      }
    }
  },
  "root": {
    "id": "docs",
    "kind": "Screen",
    "children": [
      {
        "ref": "nav"
      },
      {
        "id": "toolbar",
        "kind": "Row",
        "padding": [
          0,
          16,
          8,
          16
        ],
        "children": [
          {
            "id": "doc-count",
            "kind": "Text",
            "font": "font.caption",
            "color": "color.textSecondary",
            "text": "共 {summary.count} 个文档"
          }
        ],
        "trailing": {
          "id": "sort-button",
          "kind": "SortButton",
          "text": "排序：{sort.label}",
          "trailingIcon": {
            "cases": [
              {
                "if": "sortOpen",
                "then": "expand_less"
              },
              {
                "else": "expand_more"
              }
            ]
          },
          "on": {
            "tap": {
              "toggle": "sort.menuOpen"
            }
          }
        }
      },
      {
        "id": "list",
        "kind": "Stack",
        "if": "hasDocs",
        "each": "docs",
        "item": {
          "id": "doc-{item.doc.id}",
          "kind": "DocRow",
          "leadingIcon": "{item.doc.icon}",
          "title": "{item.doc.title}",
          "shared": "{item.doc.shared}",
          "detail": "{item.doc.owner} · {item.doc.updated|date}",
          "on": {
            "tap": {
              "navigate": "Document",
              "with": {
                "id": "{item.doc.id}"
              }
            }
          },
          "trailing": {
            "id": "doc-{item.doc.id}-more",
            "kind": "IconButton",
            "icon": "more_horiz",
            "on": {
              "tap": {
                "open": "row-menu",
                "with": {
                  "id": "{item.doc.id}"
                }
              }
            }
          },
          "overlay": {
            "id": "doc-{item.doc.id}-menu",
            "kind": "Menu",
            "if": "item.menuOpen",
            "anchor": "top-trailing",
            "dismiss": "tap outside or choose an item",
            "children": [
              {
                "id": "doc-{item.doc.id}-rename",
                "kind": "MenuItem",
                "leadingIcon": "edit",
                "text": "重命名",
                "on": {
                  "tap": {
                    "open": "rename-dialog",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              },
              {
                "id": "doc-{item.doc.id}-copy",
                "kind": "MenuItem",
                "leadingIcon": "link",
                "text": "复制链接",
                "on": {
                  "tap": {
                    "copy": "Document",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              },
              {
                "id": "doc-{item.doc.id}-move",
                "kind": "MenuItem",
                "leadingIcon": "drive_file_move",
                "text": "移动到…",
                "on": {
                  "tap": {
                    "navigate": "MoveDocument",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              },
              {
                "id": "doc-{item.doc.id}-divider",
                "kind": "MenuDivider"
              },
              {
                "id": "doc-{item.doc.id}-delete",
                "kind": "MenuItem",
                "leadingIcon": "delete",
                "text": "删除",
                "destructive": true,
                "disabled": "!canDelete",
                "$why": "only the owner may delete; others see it greyed so they know it exists",
                "on": {
                  "tap": {
                    "open": "confirm-delete",
                    "with": {
                      "id": "{item.doc.id}"
                    }
                  }
                }
              }
            ]
          }
        },
        "overlay": {
          "id": "sort-menu",
          "kind": "Menu",
          "if": "sortOpen",
          "anchor": "top-trailing",
          "width": 180,
          "dismiss": "tap outside or choose an option",
          "children": {
            "id": "sort-options",
            "kind": "Stack",
            "each": "sort.options",
            "item": {
              "id": "sort-{item.id}",
              "kind": "MenuItem",
              "text": "{item.label}",
              "selected": "{item.selected}",
              "on": {
                "tap": {
                  "call": "listDocs",
                  "with": {
                    "sort": "{item.id}"
                  }
                }
              }
            }
          }
        }
      },
      {
        "id": "empty",
        "kind": "EmptyState",
        "if": "!hasDocs",
        "icon": "folder_open",
        "title": "还没有文档",
        "detail": "新建一个，或者把文件拖到这里",
        "action": {
          "id": "empty-new",
          "kind": "Button",
          "text": "新建文档",
          "on": {
            "tap": {
              "call": "newDocument"
            }
          }
        }
      }
    ],
    "overlay": {
      "id": "confirm-delete",
      "kind": "Dialog",
      "if": "confirmingDelete",
      "anchor": "center",
      "width": {
        "compact": "88%",
        "regular": 400
      },
      "$why": "deleting is for everyone and cannot be undone, so the menu item only asks; this button deletes",
      "children": [
        {
          "id": "confirm-delete-title",
          "kind": "Text",
          "text": "删除这个文档？",
          "font": "font.heading"
        },
        {
          "id": "confirm-delete-detail",
          "kind": "Text",
          "text": "团队里的所有人都将无法再打开它，删除后无法恢复。",
          "color": "color.textSecondary"
        },
        {
          "id": "confirm-delete-actions",
          "kind": "Row",
          "gap": 12,
          "children": [
            {
              "id": "confirm-delete-cancel",
              "kind": "Button",
              "variant": "secondary",
              "text": "取消",
              "on": {
                "tap": {
                  "close": "confirm-delete"
                }
              }
            },
            {
              "id": "confirm-delete-confirm",
              "kind": "Button",
              "variant": "primary",
              "destructive": true,
              "text": "删除",
              "on": {
                "tap": {
                  "call": "deleteDoc",
                  "with": {
                    "id": "{rowMenu.docId}"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "phases": {
    "loading": {
      "id": "loading",
      "kind": "Screen",
      "children": [
        {
          "ref": "nav"
        },
        {
          "id": "sk",
          "kind": "Stack",
          "padding": 16,
          "children": [
            {
              "id": "sk-lines",
              "kind": "Skeleton",
              "shape": [
                "line 30%",
                "line 90%",
                "line 60%",
                "line 90%",
                "line 60%",
                "line 90%",
                "line 60%"
              ]
            }
          ]
        }
      ]
    },
    "error": {
      "id": "error",
      "kind": "Screen",
      "children": [
        {
          "ref": "nav"
        },
        {
          "id": "err",
          "kind": "EmptyState",
          "icon": "cloud_off",
          "title": "文档加载失败",
          "detail": "检查网络后重试",
          "action": {
            "id": "retry",
            "kind": "Button",
            "text": "重试",
            "on": {
              "tap": {
                "call": "listDocs",
                "with": {
                  "sort": "updated"
                }
              }
            }
          }
        }
      ]
    }
  }
}
