{
  "screen": "DocumentList",
  "title": "团队文档",
  "locale": "zh-CN",
  "tokens": "tokens.json",
  "$comment": "A team's documents: sorted by a dropdown in the toolbar, each row with a ⋯ menu of actions and a box that picks it, to delete several at once.",
  "data": {
    "summary": "Summary",
    "sort": "Sort",
    "docs": {
      "type": "DocRow[]",
      "from": "listDocs.docs"
    },
    "next": {
      "type": "string?",
      "from": "listDocs.next",
      "doc": "Where the next page of documents starts; null once the last page is loaded"
    },
    "rowMenu": {
      "type": "RowMenu?",
      "view": true,
      "doc": "The document whose ⋯ menu is open; null while it is closed"
    },
    "selection": {
      "type": "Selection?",
      "view": true,
      "doc": "What the person has picked to act on together; null while nothing is"
    }
  },
  "types": {
    "Summary": {
      "count": {
        "type": "int 0..",
        "derived": { "app": "docs' length" }
      }
    },
    "Sort": {
      "label": {
        "type": "string 1..8",
        "derived": { "app": "the selected option's label" }
      },
      "menuOpen": {
        "type": "bool = false",
        "view": true,
        "doc": "The sort menu is open"
      },
      "options": "SortOption[] 2..6"
    },
    "SortOption": {
      "id": "SortKey",
      "label": "string 1..8",
      "selected": "bool = false"
    },
    "SortKey": "enum(updated, created, title, owner)",
    "DocRow": {
      "doc": "Doc",
      "menuOpen": {
        "type": "bool = false",
        "view": true,
        "derived": { "app": "rowMenu is open on this document" }
      },
      "selected": {
        "type": "bool = false",
        "view": true,
        "derived": { "app": "selection holds this document" }
      }
    },
    "DocPage": {
      "docs": "Doc[] ..50",
      "next": "string?"
    },
    "Doc": {
      "id": "string",
      "title": "string 1..60",
      "icon": {
        "type": "icon",
        "doc": "description / table_chart / slideshow, by the document's type"
      },
      "owner": "string 1..20",
      "updated": "date",
      "shared": "bool = false"
    },
    "RowMenu": {
      "docId": "string",
      "canDelete": {
        "type": "bool = false",
        "derived": { "server": "the person owns the document" }
      },
      "confirming": {
        "type": "bool = false",
        "view": true,
        "doc": "The delete confirmation is open for this document"
      }
    },
    "Selection": {
      "ids": {
        "type": "string[] 1..50",
        "doc": "The picked documents' ids, in the order shown"
      },
      "count": {
        "type": "int 1..",
        "derived": { "app": "ids' length" }
      },
      "confirming": {
        "type": "bool = false",
        "doc": "The confirmation to delete them is open"
      }
    }
  },
  "conditions": {
    "hasDocs": {
      "when": "summary.count > 0",
      "label": "Has documents"
    },
    "hasMore": {
      "when": "next != null",
      "label": "More to load"
    },
    "sortOpen": {
      "when": "sort.menuOpen",
      "label": "Sort menu open"
    },
    "rowMenuOpen": {
      "when": "rowMenu != null",
      "label": "A row's menu is open"
    },
    "canDelete": {
      "when": "rowMenuOpen && rowMenu.canDelete",
      "label": "May delete it"
    },
    "confirmingDelete": {
      "when": "canDelete && rowMenu.confirming",
      "label": "Delete confirmation open"
    },
    "hasSelection": {
      "when": "selection != null",
      "label": "Some documents picked"
    },
    "confirmingDeleteSelected": {
      "when": "hasSelection && selection.confirming",
      "label": "Confirmation to delete the picked ones open"
    }
  },
  "operations": {
    "listDocs": {
      "query": "The team's documents, in the order sort names",
      "params": {
        "sort": "SortKey = \"updated\""
      },
      "pages": "cursor",
      "result": "DocPage",
      "fails": {
        "offline": "the server cannot be reached"
      }
    },
    "deleteDoc": {
      "command": "Deletes a document for everyone in the team",
      "params": {
        "id": "string"
      },
      "requires": "canDelete",
      "destructive": true,
      "bulk": "deleteDocs",
      "fails": {
        "notFound": "the document is already gone",
        "forbidden": "the person no longer owns it"
      }
    },
    "newDocument": {
      "command": "Creates an empty document owned by the person, and answers with it",
      "result": "Doc",
      "fails": {
        "offline": "the server cannot be reached"
      }
    }
  },
