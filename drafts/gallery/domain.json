{
  "$comment": "The gallery's journeys, described as a screen would be: a design of the gallery, not how it is built (ADR 0017 still draws it by hand).",
  "types": {
    "Stop": {
      "number": "int 1..",
      "screen": {
        "type": "string 1..",
        "doc": "The step's screen, by its directory under the project root"
      },
      "state": "string 1..",
      "last": {
        "type": "bool = false",
        "doc": "The journey's last step"
      },
      "here": {
        "type": "bool = false",
        "doc": "The step shown"
      },
      "passed": {
        "type": "bool = false",
        "doc": "A step before the one shown"
      },
      "broken": {
        "type": "bool = false",
        "doc": "The step check names, where the journey breaks"
      }
    },
    "Journey": {
      "name": "string 1..",
      "about": {
        "type": "string",
        "doc": "The journey's $comment; empty when it has none"
      },
      "steps": {
        "type": "int 1..",
        "derived": {
          "app": "stops' length"
        }
      },
      "stops": "Stop[] 1..",
      "brokenAt": {
        "type": "int?",
        "doc": "The step check names first, when it does not walk"
      },
      "route": {
        "type": "string 1..",
        "derived": {
          "app": "the stops' screens, joined by ›, a screen twice in a row once"
        }
      }
    },
    "TreeRow": {
      "name": "string 1..",
      "depth": "int 0..4",
      "kind": "RowKind",
      "meta": "string = \"\"",
      "picked": "bool = false"
    },
    "RowKind": "enum(directory, description, state, phase)",
    "Note": {
      "id": "string 1..",
      "stands": "NoteStands",
      "messages": "Message[] 1.."
    },
    "NoteStands": "enum(waiting, answered)",
    "Message": {
      "who": "Who",
      "text": "string 1.."
    },
    "Who": "enum(person, agent)",
    "Fault": {
      "at": "string 1..",
      "problem": "string 1..",
      "file": "string 1.."
    }
  },
  "conditions": {
    "Journey.broken": {
      "when": "brokenAt != null",
      "label": "Does not walk"
    },
    "Journey.told": {
      "when": "about != \"\"",
      "label": "Says what it is about"
    },
    "Message.mine": {
      "when": "who == \"person\"",
      "label": "Said by the person"
    },
    "TreeRow.heading": {
      "when": "kind == \"directory\" || kind == \"description\"",
      "label": "A directory or a description"
    },
    "TreeRow.phase": {
      "when": "kind == \"phase\"",
      "label": "A phase"
    },
    "TreeRow.metered": {
      "when": "meta != \"\"",
      "label": "Says how many"
    }
  }
}
