  "root": {
    "id": "window",
    "component": "Window",
    "children": [
      {
        "id": "tree",
        "component": "Stack",
        "gap": 0,
        "padding": [
          8,
          0
        ],
        "border": "color.border",
        "only": "regular",
        "children": [
          {
            "id": "lines",
            "component": "List",
            "gap": 0,
            "each": "lines",
            "item": {
              "id": "line-{index}",
              "component": "TreeLine",
              "name": "{item.name}",
              "depth": "{item.depth}",
              "heading": "{item.heading}",
              "phase": "{item.phase}",
              "meta": "{item.meta}",
              "picked": false
            }
          },
          {
            "id": "journeys-heading",
            "component": "TreeLine",
            "name": "journeys/",
            "depth": 2,
            "heading": true,
            "phase": false,
            "meta": "paths through shop",
            "picked": false
          },
          {
            "id": "journeys",
            "component": "List",
            "gap": 0,
            "each": "journeys",
            "item": {
              "id": "journey-{index}",
              "component": "JourneyEntry",
              "with": {
                "journey": "{item.journey}",
                "picked": "{item.played}"
              }
            }
          }
        ]
      },
      {
        "id": "pictures",
        "component": "Stack",
        "gap": 16,
        "padding": 24,
        "children": [
          {
            "id": "title",
            "component": "Text",
            "text": "{description}",
            "font": "font.heading"
          },
          {
            "id": "states",
            "component": "Grid",
            "columns": {
              "compact": 1,
              "regular": 3
            },
            "gap": 24,
            "each": "states",
            "index": "state",
            "item": {
              "id": "state-{index}",
              "component": "Stack",
              "gap": 6,
              "children": [
                {
                  "id": "state-{index}-caption",
                  "component": "Text",
                  "text": "{item.name}",
                  "font": "font.subhead"
                },
                {
                  "id": "state-{index}-marks",
                  "component": "Stack",
                  "gap": 4,
                  "if": "item.marked",
                  "each": "item.marks",
                  "item": {
                    "id": "state-{state}-mark-{index}",
                    "component": "JourneyMark",
                    "journey": "{item.journey}",
                    "step": "{item.step}",
                    "of": "{item.of}",
                    "walks": "{item.walks}",
                    "on": {
                      "tap": {
                        "navigate": "Play"
                      }
                    }
                  }
                },
                {
                  "id": "state-{index}-picture",
                  "component": "Thumb"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "sidebar",
        "component": "Stack",
        "gap": 12,
        "padding": 12,
        "border": "color.border",
        "children": [
          {
            "id": "guide",
            "component": "Card",
            "gap": 6,
            "padding": 12,
            "border": "color.border",
            "children": [
              {
                "id": "guide-title",
                "component": "Text",
                "text": "Nothing picked",
                "font": "font.subhead"
              },
              {
                "id": "guide-click",
                "component": "Text",
                "text": "Click a state, an arrow or a journey's mark.",
                "font": "font.caption",
                "color": "color.textSecondary"
              }
            ]
          }
        ]
      }
    ]
  },
  "components": {
    "JourneyMark": {
      "doc": "A journey passing through a state, under its caption: the route icon, its name, the step of how many; dashed when the journey is broken, which picking it shows.",
      "params": [
        "journey",
        "step",
        "of",
        "walks"
      ],
      "look": {
        "box": "row",
        "gap": 4,
        "items": "center",
        "self": "start",
        "padding": [
          2,
          8
        ],
        "radius": 999,
        "stroke": "line",
        "dashed": {
          "cases": [
            {
              "if": "walks",
              "then": false
            },
            {
              "else": true
            }
          ]
        },
        "children": [
          {
            "component": "Glyph",
            "icon": "route",
            "size": 12
          },
          {
            "text": "{journey}",
            "font": "font.caption",
            "weight": 600,
            "maxLines": 1
          },
          {
            "text": {
              "cases": [
                {
                  "if": "walks",
                  "then": "step {step} of {of}"
                },
                {
                  "else": "step {step} of {of} · broken"
                }
              ]
            },
            "font": "font.caption",
            "ink": "muted"
          }
        ]
      }
    },
    "Thumb": {
      "doc": "A state's small picture.",
      "params": [],
      "look": {
        "box": "column",
        "aspect": "9:12",
        "stroke": "line",
        "cross": "line"
      }
    }
  }
}
