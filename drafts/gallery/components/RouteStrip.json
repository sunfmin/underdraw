{
  "$comment": "A journey drawn as the path it is: its stops in order on one line, the step shown filled. Over the pictures while it plays, and at the head of the flow it is drawn on.",
  "params": {
    "journey": "Journey"
  },
  "nodes": {
    "component": "Row",
    "gap": 0,
    "each": "journey.stops",
    "item": {
      "id": "stop-{index}",
      "component": "RouteStop",
      "number": "{item.number}",
      "screen": "{item.screen}",
      "state": "{item.state}",
      "here": "{item.here}",
      "passed": "{item.passed}",
      "broken": "{item.broken}",
      "last": "{item.last}"
    }
  },
  "fixtures": {
    "playing": {
      "journey": {
        "name": "cancel-an-order",
        "about": "The person opens an order from the list and cancels it before it ships.",
        "steps": 3,
        "brokenAt": null,
        "stops": [
          {
            "number": 1,
            "screen": "orders",
            "state": "default",
            "passed": true
          },
          {
            "number": 2,
            "screen": "order",
            "state": "open",
            "here": true
          },
          {
            "number": 3,
            "screen": "order",
            "state": "cancelled",
            "last": true
          }
        ],
        "route": "orders › order"
      }
    },
    "broken": {
      "journey": {
        "name": "refund-a-cancelled-order",
        "about": "",
        "steps": 2,
        "brokenAt": 2,
        "stops": [
          {
            "number": 1,
            "screen": "order",
            "state": "cancelled"
          },
          {
            "number": 2,
            "screen": "order",
            "state": "refunded",
            "last": true,
            "broken": true
          }
        ],
        "route": "order"
      }
    }
  },
  "$note": "Clicking a stop should show its step; a shared component cannot set the screen's view state it is passed (see the issue opened for it), so the screens say it in their transitions instead."
}
