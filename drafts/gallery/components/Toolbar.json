{
  "$comment": "The bar along the window's top, over the tree, the pictures and the sidebar, in every view.",
  "params": { "bar": "Bar" },
  "nodes": {
    "component": "NavBar", "border": "color.border",
    "leading": [
      { "id": "back", "component": "IconButton", "icon": "arrow_back", "disabled": "!bar.canBack",
        "on": { "tap": { "back": true } } },
      { "id": "forward", "component": "IconButton", "icon": "arrow_forward", "disabled": "!bar.canForward", "only": "regular" }
    ],
    "children": [
      { "id": "crumbs", "component": "Text", "text": "{bar.crumbs}", "font": "font.subhead", "maxLines": 1,
        "assumed": "工具栏中间放面包屑，一眼看出现在在哪个目录、哪个描述、哪个状态；也可以不放，只靠左边树里的高亮来表示位置。" }
    ],
    "trailing": [
      { "id": "mode", "component": "Row", "gap": 0, "only": "regular",
        "assumed": "用一个「检查 / 试玩」切换代替只能靠按住 ⌘ 点击来试玩：试玩模式下普通点击就走原型；也可以保持现在的 ⌘-click，不加切换。",
        "children": [
          { "id": "inspect", "component": "Button", "size": "small", "text": "Inspect",
            "variant": { "cases": [ { "if": "bar.inspecting", "then": "primary" }, { "else": "secondary" } ] },
            "on": { "tap": { "set": "bar.mode", "to": "inspect" } } },
          { "id": "play", "component": "Button", "size": "small", "text": "Play",
            "variant": { "cases": [ { "if": "bar.playing", "then": "primary" }, { "else": "secondary" } ] },
            "on": { "tap": { "set": "bar.mode", "to": "play" } } }
        ] },
      { "id": "agent", "component": "Badge", "only": "regular",
        "text": { "cases": [ { "if": "bar.listening", "then": "● agent listening" }, { "else": "○ no agent listening" } ] },
        "assumed": "工具栏常驻显示有没有 agent 在用 notes --wait 听这个目录，没人听时人一眼就知道写的笔记暂时没人处理；也可以只在发出笔记之后才在对话里说。" },
      { "id": "inbox", "component": "Button", "size": "small", "if": "bar.owed",
        "text": "{bar.waitingOnYou} waiting on you",
        "variant": { "cases": [ { "if": "bar.inboxOpen", "then": "primary" }, { "else": "secondary" } ] },
        "on": { "tap": { "toggle": "bar.inboxOpen" } },
        "assumed": "「等你处理」的数量常驻在工具栏，点一下就在侧栏列出来，不管当前选中了什么；也可以像现在一样只在什么都没选中时才在侧栏里出现。" },
      { "id": "sidebar", "component": "IconButton", "only": "regular",
        "icon": { "cases": [ { "if": "bar.sidebarShown", "then": "right_panel_close" }, { "else": "right_panel_open" } ] },
        "on": { "tap": { "toggle": "bar.sidebar" } } }
    ]
  },
  "fixtures": {
    "inspecting": { "bar": { "back": true, "crumbs": "drafts › shop › order › open", "agent": "listening",
                             "waitingOnYou": 3 } },
    "playing":    { "bar": { "forward": true, "crumbs": "drafts › shop › order › cancel-dialog", "mode": "play",
                             "agent": "away", "waitingOnYou": 0, "sidebar": false } },
    "inbox-open": { "$patch": "inspecting", "bar": { "inboxOpen": true } }
  }
}
