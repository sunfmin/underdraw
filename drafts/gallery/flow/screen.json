{
  "screen": "Flow",
  "title": "The flow, with a journey's path drawn on it",
  "tokens": "tokens.json",
  "$comment": "Today a journey is not drawn on the flow at all. Picking a directory shows its flow, and above it the journeys under it: picking one draws its path over the screens, each box on it numbered with its steps and the arrows it takes in the strong ink; the others fade.",
  "data": {
    "lines": "TreeRow[]",
    "journeys": "TreeJourney[]",
    "shown": {
      "type": "Journey[] ..1",
      "view": true,
      "doc": "The journey whose path is drawn: none, or one (a list, as a component's \"with\" does not take a nullable value under its \"if\")"
    },
    "boxes": "FlowBox[]",
    "shownCount": {
      "type": "int 0..1",
      "derived": {
        "app": "shown's length"
      }
    }
  },
  "types": {
    "TreeJourney": {
      "journey": "Journey",
      "played": "bool = false",
      "drawn": {
        "type": "bool = false",
        "doc": "Its path drawn on the flow"
      }
    },
    "FlowBox": {
      "name": "string 1..",
      "steps": {
        "type": "string = \"\"",
        "doc": "The journey's steps on this screen, \"2 · 3\"; empty off its path"
      },
      "arrow": {
        "type": "string = \"\"",
        "doc": "The navigate leaving it to the next box, by the node's id"
      },
      "onPath": "bool = false"
    }
  },
  "conditions": {
    "showing": {
      "when": "shownCount > 0",
      "label": "A journey's path drawn"
    },
    "FlowBox.stepped": {
      "when": "steps != \"\"",
      "label": "On the journey's path"
    },
    "FlowBox.leaves": {
      "when": "arrow != \"\"",
      "label": "Navigates on"
    }
  },
  "fixtures": {
