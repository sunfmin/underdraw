{
  "screen": "Play",
  "title": "A journey played, step by step",
  "tokens": "tokens.json",
  "$comment": "A journey picked in the tree plays from its first step. Over the pictures, the journey as a route: every step, where the person is, what it is about. The sidebar says, in plain words, the one thing to act on next and where it leads; → and ← step it.",
  "data": {
    "bar": {
      "type": "Bar",
      "view": true
    },
    "lines": "TreeRow[]",
    "journeys": "TreeJourney[]",
    "journey": "Journey",
    "step": "PlayStep",
    "picked": {
      "type": "PickedNode?",
      "view": true,
      "doc": "A node clicked in the step's picture"
    },
    "note": {
      "type": "Note?",
      "doc": "The note on the whole journey, once the person says something about it"
    },
    "fault": {
      "type": "Fault?",
      "doc": "Where check finds the journey broken"
    },
    "journeysOpen": {
      "type": "bool = true",
      "view": true,
      "doc": "The journeys/ heading unfolded"
    }
  },
  "types": {
    "PlayStep": {
      "number": "int 1..",
      "screen": "string 1..",
      "state": "string 1..",
      "act": {
        "type": "string",
        "doc": "What the person does at this step, in their words: the node's own text, not its id"
      },
      "label": {
        "type": "int?",
        "doc": "The number the node acted on is labelled with in the picture"
      },
      "answer": {
        "type": "string = \"\"",
        "doc": "For an act that calls an operation, the outcome the journey takes"
      },
      "leadsTo": "string",
      "first": "bool = false",
      "last": "bool = false"
    },
    "PickedNode": {
      "id": "string 1..",
      "component": "string 1..",
      "calls": "string"
    },
    "TreeJourney": {
      "journey": "Journey",
      "played": "bool = false"
    }
  },
  "conditions": {
    "atFirst": {
      "when": "step.first",
      "label": "The first step"
    },
    "atLast": {
      "when": "step.last",
      "label": "The last step"
    },
    "hasPicked": {
      "when": "picked != null",
      "label": "A node picked"
    },
    "noPicked": {
      "when": "picked == null",
      "label": "No node picked"
    },
    "talked": {
      "when": "note != null",
      "label": "The journey has a note"
    },
    "broken": {
      "when": "fault != null",
      "label": "The journey does not walk"
    },
    "walks": {
      "when": "fault == null",
      "label": "The journey walks"
    },
    "acting": {
      "when": "walks && !atLast",
      "label": "A step that acts"
    },
    "ending": {
      "when": "walks && atLast",
      "label": "The last step"
    },
    "answers": {
      "when": "step.answer != \"\"",
      "label": "The act answers an outcome"
    },
    "labelled": {
      "when": "!atLast && step.label != null",
      "label": "The step acts on a labelled node"
    },
    "showState": {
      "when": "walks && noPicked",
      "label": "The whole state's card"
    },
    "sidebarShown": {
      "when": "bar.sidebarShown",
      "label": "The sidebar shown"
    }
  },
  "fixtures": {
    "first": {
      "bar": {
        "back": true,
        "crumbs": "drafts › shop › → cancel-an-order",
        "agent": "listening",
        "waitingOnYou": 2
      },
      "lines": {
        "$sample": "shopLines"
      },
      "journeys": {
        "$sample": "playedJourneys"
      },
      "journey": {
        "name": "cancel-an-order",
        "about": "The person opens an order from the list and cancels it before it ships.",
        "steps": 3,
        "route": "orders › order",
        "brokenAt": null,
        "stops": [
          {
            "number": 1,
            "screen": "orders",
            "state": "default",
            "here": true
          },
          {
            "number": 2,
            "screen": "order",
            "state": "open"
          },
          {
            "number": 3,
            "screen": "order",
            "state": "cancelled",
            "last": true
          }
        ]
      },
      "step": {
        "number": 1,
        "screen": "orders",
        "state": "default",
        "act": "Tap the order row",
        "label": 1,
        "answer": "",
        "leadsTo": "order · open",
        "first": true,
        "last": false
      },
      "picked": null,
      "note": null,
      "fault": null
    },
    "middle": {
      "bar": {
        "back": true,
        "crumbs": "drafts › shop › → cancel-an-order",
        "agent": "listening",
        "waitingOnYou": 2
      },
      "lines": {
        "$sample": "shopLines"
      },
      "journeys": {
        "$sample": "playedJourneys"
      },
      "journey": {
        "$sample": "cancelAnOrderAtStep2"
      },
      "step": {
        "number": 2,
        "screen": "order",
        "state": "open",
        "act": "Tap “Cancel order”",
        "label": 1,
        "answer": "it answers ok",
        "leadsTo": "order · cancelled",
        "first": false,
        "last": false
      },
      "picked": null,
      "note": null,
      "fault": null
    },
    "last": {
      "$patch": "first",
      "journey": {
        "stops": [
          {
            "number": 1,
            "screen": "orders",
            "state": "default",
            "passed": true
          },
          {
            "number": 2,
            "screen": "order",
            "state": "open",
            "passed": true
          },
          {
            "number": 3,
            "screen": "order",
            "state": "cancelled",
            "last": true,
            "here": true
          }
        ]
      },
      "step": {
        "number": 3,
        "screen": "order",
        "state": "cancelled",
        "act": "",
        "label": null,
        "leadsTo": "",
        "first": false,
        "last": true
      }
    },
    "node-picked": {
      "$patch": "middle",
      "picked": {
        "id": "summary-total",
        "component": "Text",
        "calls": "nothing"
      }
    },
    "talked-about": {
      "$patch": "middle",
      "note": {
        "id": "N4",
        "stands": "answered",
        "messages": [
          {
            "who": "person",
            "text": "Cancelling takes three steps; could the list cancel in one?"
          },
          {
            "who": "agent",
            "text": "Added a cancel button to each row; the journey is two steps now. Play it again?"
          }
        ]
      }
    },
    "broken": {
      "lines": {
        "$sample": "shopLines"
      },
      "journeys": [
        {
          "journey": {
            "name": "cancel-an-order",
            "about": "The person opens an order from the list and cancels it before it ships.",
            "steps": 3,
            "route": "orders › order",
            "brokenAt": null,
            "stops": [
              {
                "number": 1,
                "screen": "orders",
                "state": "default"
              },
              {
                "number": 2,
                "screen": "order",
                "state": "open"
              },
              {
                "number": 3,
                "screen": "order",
                "state": "cancelled",
                "last": true
              }
            ]
          },
          "played": false
        },
        {
          "journey": {
            "name": "refund-a-cancelled-order",
            "about": "",
            "steps": 2,
            "route": "order",
            "brokenAt": 2,
            "stops": [
              {
                "number": 1,
                "screen": "order",
                "state": "cancelled"
              },
              {
                "number": 2,
                "screen": "order",
                "state": "refunded",
                "last": true,
                "broken": true
              }
            ]
          },
          "played": true
        }
      ],
      "journey": {
        "$sample": "refundACancelledOrder"
      },
      "step": {
        "number": 2,
        "screen": "order",
        "state": "refunded",
        "act": "",
        "label": null,
        "answer": "",
        "leadsTo": "",
        "first": false,
        "last": true
      },
      "picked": null,
      "note": null,
      "fault": {
        "at": "steps.1.state",
        "problem": "refunded is not a state of order: name a fixture or a phase (open, shipped, cancelled)",
        "file": "shop/journeys/refund-a-cancelled-order.json"
      },
      "bar": {
        "forward": true,
        "crumbs": "drafts › shop › → cancel-an-order",
        "mode": "play",
        "agent": "away",
        "waitingOnYou": 0,
        "sidebar": false
      }
    }
  },
  "transitions": [
    {
      "from": "first",
      "on": "next.tap",
      "to": "middle"
    },
    {
      "from": "middle",
      "on": "next.tap",
      "to": "last"
    },
    {
      "from": "middle",
      "on": "back.tap",
      "to": "first"
    },
    {
      "from": "last",
      "on": "back.tap",
      "to": "middle"
    },
    {
      "from": "last",
      "on": "again.tap",
      "to": "first"
    },
    {
      "from": "middle",
      "on": "picture-2.tap",
      "to": "node-picked"
    },
    {
      "from": "node-picked",
      "on": "picture-2.tap",
      "to": "middle"
    }
  ],
  "root": {
    "id": "screen",
    "component": "Screen",
    "gap": 0,
    "children": [
      {
        "id": "toolbar",
        "component": "Toolbar",
        "with": {
          "bar": "{bar}"
        }
      },
      {
        "id": "window",
        "component": "Window",
        "children": [
          {
            "id": "tree",
            "component": "Stack",
            "gap": 0,
            "padding": [
              8,
              0
            ],
            "border": "color.border",
            "only": "regular",
            "children": [
              {
                "id": "lines",
                "component": "List",
                "gap": 0,
                "each": "lines",
                "item": {
                  "id": "line-{index}",
                  "component": "TreeLine",
                  "name": "{item.name}",
                  "depth": "{item.depth}",
                  "heading": "{item.heading}",
                  "phase": "{item.phase}",
                  "meta": "{item.meta}",
                  "picked": false,
                  "children": [
                    {
                      "id": "line-{index}-fold",
                      "component": "Disclosure",
                      "if": "item.heading",
                      "open": {
                        "cases": [
                          {
                            "if": "item.unfolded",
                            "then": true
                          },
                          {
                            "else": false
                          }
                        ]
                      },
                      "on": {
                        "tap": {
                          "toggle": "item.open"
                        }
                      }
                    },
                    {
                      "id": "line-{index}-space",
                      "component": "FoldSpace",
                      "if": "!item.heading"
                    }
                  ]
                }
              },
              {
                "id": "journeys-heading",
                "component": "TreeLine",
                "name": "journeys/",
                "depth": 2,
                "heading": true,
                "phase": false,
                "meta": "paths through shop",
                "picked": false,
                "children": [
                  {
                    "id": "journeys-fold",
                    "component": "Disclosure",
                    "open": "{journeysOpen}",
                    "on": {
                      "tap": {
                        "toggle": "journeysOpen"
                      }
                    }
                  }
                ]
              },
              {
                "id": "journeys",
                "component": "List",
                "gap": 0,
                "each": "journeys",
                "item": {
                  "id": "journey-{index}",
                  "component": "JourneyEntry",
                  "with": {
                    "journey": "{item.journey}",
                    "picked": "{item.played}"
                  }
                }
              }
            ]
          },
          {
            "id": "pictures",
            "component": "Stack",
            "gap": 20,
            "padding": 24,
            "children": [
              {
                "id": "route-head",
                "component": "Stack",
                "gap": 10,
                "children": [
                  {
                    "id": "route-title",
                    "component": "Row",
                    "gap": 8,
                    "children": [
                      {
                        "id": "route-icon",
                        "component": "Glyph",
                        "icon": "route",
                        "size": 18
                      },
                      {
                        "id": "route-name",
                        "component": "Text",
                        "text": "{journey.name}",
                        "font": "font.heading"
                      },
                      {
                        "id": "route-steps",
                        "component": "Text",
                        "text": "{journey.steps} steps",
                        "font": "font.caption",
                        "color": "color.textSecondary"
                      }
                    ]
                  },
                  {
                    "id": "route-about",
                    "component": "Text",
                    "if": "journey.told",
                    "text": "{journey.about}",
                    "color": "color.textSecondary",
                    "only": "compact",
                    "$comment": "At regular the tree beside it already says what the journey is about."
                  },
                  {
                    "id": "route",
                    "component": "RouteStrip",
                    "with": {
                      "journey": "{journey}"
                    }
                  }
                ]
              },
              {
                "id": "cue",
                "component": "Stack",
                "if": "walks",
                "gap": 10,
                "$comment": "The one thing to do next, as the headline over the pictures: its badge is the label the node to act on carries in them.",
                "children": [
                  {
                    "id": "cue-act",
                    "component": "Row",
                    "if": "acting",
                    "gap": 10,
                    "children": [
                      {
                        "id": "cue-label",
                        "component": "ActMark",
                        "if": "labelled",
                        "number": "{step.label}"
                      },
                      {
                        "id": "cue-act-text",
                        "component": "Text",
                        "text": "{step.act}",
                        "font": "font.cue"
                      }
                    ]
                  },
                  {
                    "id": "cue-leads",
                    "component": "Text",
                    "if": "acting",
                    "text": {
                      "cases": [
                        {
                          "if": "answers",
                          "then": "Leads to {step.leadsTo}, once {step.answer}"
                        },
                        {
                          "else": "Leads to {step.leadsTo}"
                        }
                      ]
                    },
                    "color": "color.textSecondary"
                  },
                  {
                    "id": "cue-end",
                    "component": "Text",
                    "if": "ending",
                    "text": "The journey ends here.",
                    "font": "font.cue"
                  },
                  {
                    "id": "cue-buttons",
                    "component": "Row",
                    "gap": 8,
                    "children": [
                      {
                        "id": "back",
                        "component": "Button",
                        "variant": "secondary",
                        "size": "small",
                        "text": "← Back",
                        "disabled": "atFirst",
                        "on": {
                          "tap": {
                            "set": "picked",
                            "to": null
                          }
                        }
                      },
                      {
                        "id": "next",
                        "component": "Button",
                        "variant": "primary",
                        "size": "small",
                        "text": "Next →",
                        "if": "!atLast",
                        "on": {
                          "tap": {
                            "set": "picked",
                            "to": null
                          }
                        }
                      },
                      {
                        "id": "again",
                        "component": "Button",
                        "variant": "secondary",
                        "size": "small",
                        "text": "Play again",
                        "if": "atLast",
                        "on": {
                          "tap": {
                            "set": "picked",
                            "to": null
                          }
                        }
                      },
                      {
                        "id": "keys",
                        "component": "Text",
                        "text": "or ← →",
                        "font": "font.caption",
                        "color": "color.textSecondary"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "step-pictures",
                "component": "Columns",
                "if": "walks",
                "gap": 24,
                "columns": {
                  "compact": [
                    "1fr"
                  ],
                  "regular": [
                    "2fr",
                    "5fr"
                  ]
                },
                "children": [
                  {
                    "id": "picture-1",
                    "component": "StepPicture",
                    "caption": "{step.state} · 390",
                    "aspect": "9:14",
                    "next": {
                      "cases": [
                        {
                          "if": "labelled",
                          "then": "{step.label}"
                        },
                        {
                          "else": ""
                        }
                      ]
                    },
                    "tall": true,
                    "on": {
                      "tap": {
                        "set": "picked",
                        "to": null
                      }
                    }
                  },
                  {
                    "id": "picture-2",
                    "component": "StepPicture",
                    "caption": "{step.state} · 1120",
                    "aspect": "16:9",
                    "next": {
                      "cases": [
                        {
                          "if": "labelled",
                          "then": "{step.label}"
                        },
                        {
                          "else": ""
                        }
                      ]
                    },
                    "tall": false,
                    "on": {
                      "tap": {
                        "set": "picked",
                        "to": null
                      }
                    },
                    "only": "regular"
                  }
                ]
              },
              {
                "id": "fault",
                "component": "Stack",
                "if": "broken",
                "gap": 8,
                "padding": 0,
                "children": [
                  {
                    "id": "fault-title",
                    "component": "Text",
                    "text": "Step {step.number} cannot be played",
                    "font": "font.cue"
                  },
                  {
                    "id": "fault-problem",
                    "component": "Text",
                    "text": "{fault.problem}"
                  },
                  {
                    "id": "fault-where",
                    "component": "Text",
                    "text": "{fault.at} in {fault.file}",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  },
                  {
                    "id": "fault-fix",
                    "component": "Text",
                    "text": "Fix the file and the journey plays again, from the step shown.",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  }
                ]
              }
            ]
          },
          {
            "id": "sidebar",
            "component": "Stack",
            "gap": 0,
            "padding": [
              4,
              16
            ],
            "border": "color.border",
            "children": [
              {
                "id": "journey-note",
                "component": "Stack",
                "gap": 8,
                "padding": [
                  14,
                  0
                ],
                "children": [
                  {
                    "id": "jn-title",
                    "component": "Text",
                    "text": "→ {journey.name} · the whole journey",
                    "font": "font.subhead"
                  },
                  {
                    "id": "jn-empty",
                    "component": "Text",
                    "if": "!talked",
                    "text": "Say something about the whole path: how long it is, a step it should not need.",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  },
                  {
                    "id": "jn-messages",
                    "component": "List",
                    "if": "talked",
                    "gap": 6,
                    "each": "note.messages",
                    "item": {
                      "id": "jn-message-{index}",
                      "component": "Bubble",
                      "text": "{item.text}",
                      "mine": "{item.mine}"
                    }
                  }
                ]
              },
              {
                "id": "sb-rule-1",
                "component": "Divider"
              },
              {
                "id": "node-card",
                "component": "Stack",
                "if": "hasPicked",
                "gap": 6,
                "padding": [
                  14,
                  0
                ],
                "children": [
                  {
                    "id": "nc-title",
                    "component": "Text",
                    "text": "{picked.component}",
                    "font": "font.subhead"
                  },
                  {
                    "id": "nc-calls",
                    "component": "Text",
                    "text": "calls {picked.calls}",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  }
                ]
              },
              {
                "id": "sb-rule-2",
                "component": "Divider"
              },
              {
                "id": "state-card",
                "component": "Stack",
                "if": "showState",
                "padding": [
                  14,
                  0
                ],
                "children": [
                  {
                    "id": "sc-title",
                    "component": "Text",
                    "text": "{step.state} · the whole state",
                    "font": "font.subhead"
                  },
                  {
                    "id": "sc-hint",
                    "component": "Text",
                    "text": "Click a part of the picture to talk about just that.",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  }
                ],
                "gap": 4
              },
              {
                "id": "sb-rule-3",
                "component": "Divider"
              },
              {
                "id": "talk",
                "component": "Stack",
                "gap": 8,
                "children": [
                  {
                    "id": "talk-box",
                    "component": "Card",
                    "padding": 10,
                    "border": "color.border",
                    "children": [
                      {
                        "id": "talk-hint",
                        "component": "Text",
                        "text": "say something about this…",
                        "color": "color.textSecondary"
                      }
                    ]
                  }
                ],
                "padding": [
                  14,
                  0,
                  0,
                  0
                ]
              }
            ],
            "if": "sidebarShown"
          }
        ],
        "with": {
          "sidebar": "{sidebarShown}"
        }
      }
    ]
  },
  "components": {
    "StepPicture": {
      "doc": "A step's state at one width, as the gallery draws it; the node to act on next ringed twice, with its label.",
      "params": [
        "caption",
        "aspect",
        "next",
        "tall"
      ],
      "look": {
        "box": "column",
        "gap": 6,
        "children": [
          {
            "text": "{caption}",
            "font": "font.caption",
            "ink": "muted"
          },
          {
            "box": "column",
            "aspect": "{aspect}",
            "stroke": "line",
            "cross": "line",
            "children": [
              {
                "if": "next != \"\"",
                "box": "row",
                "pin": {
                  "x": "center",
                  "y": "center"
                },
                "padding": [
                  3,
                  9
                ],
                "radius": 999,
                "fill": "strong",
                "children": [
                  {
                    "text": "{next}",
                    "font": "font.subhead",
                    "ink": "paper"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "ActMark": {
      "doc": "The label of the node to act on next: a filled disc with its number, the same over the picture and beside the act it names.",
      "params": [
        "number"
      ],
      "look": {
        "box": "row",
        "radius": 999,
        "padding": [
          3,
          9
        ],
        "fill": "strong",
        "children": [
          {
            "text": "{number}",
            "font": "font.subhead",
            "ink": "paper"
          }
        ]
      }
    }
  }
}
