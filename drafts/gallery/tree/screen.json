{
  "screen": "Tree",
  "title": "The gallery's tree, with journeys",
  "tokens": "tokens.json",
  "$comment": "The tree with nothing picked. A journey is told apart from a screen and a state at a glance: under a journeys/ heading of its own, as on disk, with the route icon, how many steps, what it is about and the screens it passes through.",
  "data": {
    "bar": {
      "type": "Bar",
      "view": true
    },
    "lines": "TreeRow[]",
    "journeys": "Journey[]",
    "journeyCount": {
      "type": "int 0..",
      "derived": {
        "app": "journeys' length"
      }
    }
  },
  "types": {},
  "conditions": {
    "hasJourneys": {
      "when": "journeyCount > 0",
      "label": "Journeys under shop"
    },
    "sidebarShown": {
      "when": "bar.sidebarShown",
      "label": "The sidebar shown"
    }
  },
  "fixtures": {
    "default": {
      "bar": {
        "back": true,
        "crumbs": "drafts › shop",
        "agent": "listening",
        "waitingOnYou": 2
      },
      "lines": [
        {
          "name": "root/",
          "depth": 0,
          "kind": "directory",
          "meta": "",
          "picked": false
        },
        {
          "name": "shop/",
          "depth": 1,
          "kind": "directory",
          "meta": "",
          "picked": false
        },
        {
          "name": "components/",
          "depth": 2,
          "kind": "directory",
          "meta": "",
          "picked": false
        },
        {
          "name": "OrderRow",
          "depth": 3,
          "kind": "description",
          "meta": "",
          "picked": false
        },
        {
          "name": "OrderStatus",
          "depth": 3,
          "kind": "description",
          "meta": "",
          "picked": false
        },
        {
          "name": "order",
          "depth": 2,
          "kind": "description",
          "meta": "3 states",
          "picked": false
        },
        {
          "name": "open",
          "depth": 3,
          "kind": "state",
          "meta": "",
          "picked": false
        },
        {
          "name": "shipped",
          "depth": 3,
          "kind": "state",
          "meta": "",
          "picked": false
        },
        {
          "name": "cancelled",
          "depth": 3,
          "kind": "state",
          "meta": "",
          "picked": false
        },
        {
          "name": "orders",
          "depth": 2,
          "kind": "description",
          "meta": "2 states",
          "picked": false
        },
        {
          "name": "default",
          "depth": 3,
          "kind": "state",
          "meta": "",
          "picked": false
        },
        {
          "name": "loading",
          "depth": 3,
          "kind": "phase",
          "meta": "",
          "picked": false
        }
      ],
      "journeys": [
        {
          "name": "cancel-an-order",
          "about": "The person opens an order from the list and cancels it before it ships.",
          "steps": 3,
          "route": "orders › order",
          "brokenAt": null,
          "stops": [
            {
              "number": 1,
              "screen": "orders",
              "state": "default"
            },
            {
              "number": 2,
              "screen": "order",
              "state": "open"
            },
            {
              "number": 3,
              "screen": "order",
              "state": "cancelled",
              "last": true
            }
          ]
        },
        {
          "name": "refund-a-cancelled-order",
          "about": "",
          "steps": 2,
          "route": "order",
          "brokenAt": 2,
          "stops": [
            {
              "number": 1,
              "screen": "order",
              "state": "cancelled"
            },
            {
              "number": 2,
              "screen": "order",
              "state": "refunded",
              "last": true,
              "broken": true
            }
          ]
        }
      ],
      "journeyCount": 2
    },
    "no-journeys": {
      "$patch": "default",
      "journeys": [],
      "journeyCount": 0,
      "bar": {
        "forward": true,
        "crumbs": "drafts › shop",
        "mode": "play",
        "agent": "away",
        "waitingOnYou": 0,
        "sidebar": false,
        "back": false
      }
    }
  },
  "root": {
    "id": "screen",
    "component": "Screen",
    "gap": 0,
    "children": [
      {
        "id": "toolbar",
        "component": "Toolbar",
        "with": {
          "bar": "{bar}"
        }
      },
      {
        "id": "window",
        "component": "Window",
        "children": [
          {
            "id": "tree",
            "component": "Stack",
            "gap": 0,
            "padding": [
              8,
              0
            ],
            "only": "regular",
            "children": [
              {
                "id": "lines",
                "component": "List",
                "gap": 0,
                "each": "lines",
                "item": {
                  "id": "line-{index}",
                  "component": "TreeLine",
                  "name": "{item.name}",
                  "depth": "{item.depth}",
                  "heading": "{item.heading}",
                  "phase": "{item.phase}",
                  "meta": "{item.meta}",
                  "picked": "{item.picked}"
                }
              },
              {
                "id": "journeys-heading",
                "component": "TreeLine",
                "if": "hasJourneys",
                "name": "journeys/",
                "depth": 2,
                "heading": true,
                "phase": false,
                "meta": "paths through shop",
                "picked": false
              },
              {
                "id": "journeys",
                "component": "List",
                "gap": 0,
                "if": "hasJourneys",
                "each": "journeys",
                "item": {
                  "id": "journey-{index}",
                  "component": "JourneyEntry",
                  "with": {
                    "journey": "{item}"
                  }
                }
              }
            ],
            "border": "color.border"
          },
          {
            "id": "pictures",
            "component": "Stack",
            "padding": 24,
            "children": [
              {
                "id": "pictures-say",
                "component": "Text",
                "text": "The overview of the first description, as the window opens on it.",
                "color": "color.textSecondary"
              }
            ]
          },
          {
            "id": "sidebar",
            "component": "Stack",
            "gap": 12,
            "padding": 12,
            "children": [
              {
                "id": "guide",
                "component": "Card",
                "gap": 6,
                "padding": 12,
                "border": "color.border",
                "children": [
                  {
                    "id": "guide-title",
                    "component": "Text",
                    "text": "Nothing picked",
                    "font": "font.subhead"
                  },
                  {
                    "id": "guide-click",
                    "component": "Text",
                    "text": "Click a node, a state or an arrow to see it and talk about it.",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  }
                ]
              },
              {
                "id": "journeys-guide",
                "component": "Card",
                "if": "hasJourneys",
                "gap": 6,
                "padding": 12,
                "border": "color.border",
                "children": [
                  {
                    "id": "journeys-guide-title",
                    "component": "Row",
                    "gap": 6,
                    "children": [
                      {
                        "id": "journeys-guide-icon",
                        "component": "Glyph",
                        "icon": "route",
                        "size": 16
                      },
                      {
                        "id": "journeys-guide-name",
                        "component": "Text",
                        "text": "Journeys",
                        "font": "font.subhead"
                      }
                    ]
                  },
                  {
                    "id": "journeys-guide-what",
                    "component": "Text",
                    "text": "A journey is one path a person takes across these screens, step by step. Pick one to walk it: each step shows its screen and the one thing to act on next.",
                    "font": "font.caption",
                    "color": "color.textSecondary"
                  }
                ]
              }
            ],
            "border": "color.border",
            "if": "sidebarShown"
          }
        ],
        "with": {
          "sidebar": "{sidebarShown}"
        }
      }
    ]
  }
}
