{
  "$comment": "设计 token 的唯一来源。各平台的名字由 platforms/*.json 里的 tokenNaming 规则生成，不逐个手写。",
  "color": {
    "primary": "#FF385C",
    "primaryPressed": "#E31C5F",
    "text": "#222222",
    "textSecondary": "#6A6A6A",
    "border": "#DDDDDD",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F7F7F7",
    "star": "#222222"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "pill": 999 },
  "font": {
    "title":    { "size": 26, "weight": 600, "lineHeight": 30 },
    "heading":  { "size": 22, "weight": 600, "lineHeight": 26 },
    "subhead":  { "size": 16, "weight": 600, "lineHeight": 20 },
    "body":     { "size": 16, "weight": 400, "lineHeight": 22 },
    "caption":  { "size": 14, "weight": 400, "lineHeight": 18 },
