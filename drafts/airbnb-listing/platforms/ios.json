{
  "platform": "ios",
  "language": "swift",
  "stack": "SwiftUI（iOS 17+）",
  "testId": ".accessibilityIdentifier(\"{id}\")",
  "elementTree": "XCUITest：app.descendants(matching: .any) 按 identifier 读 frame；或 idb ui describe-all",
  "tokenNaming": { "pattern": "Theme.{group}.{name}", "example": "color.primary → Theme.color.primary；space.4 → Theme.space._4（数字开头的名字前加 _）" },
  "breakpoints": "horizontalSizeClass：.compact → compact，.regular → regular（iPad 横屏 / 分屏）",
  "components": {
    "Screen": "NavigationStack 里的一个 View",
    "NavBar": ".toolbar；transparentOverContent → .toolbarBackground(.hidden) + 滚动后渐显",
    "IconButton": "Button { } label: { Image(systemName:) }.accessibilityLabel(label)",
    "Button": "Button；variant primary → .borderedProminent + tint，secondary → .bordered",
    "Link": "Button + .buttonStyle(.plain) + 下划线文字",
    "Text": "Text；maxLines → .lineLimit；role heading → .accessibilityAddTraits(.isHeader)",
    "Scroll": "ScrollView",
    "Stack": "VStack(alignment: .leading)", "Row": "HStack",
    "Columns": "compact → VStack；regular → HStack，两列宽度用 GeometryReader 或 containerRelativeFrame",
    "Grid": "LazyVGrid",
    "ImageCarousel": "TabView + .tabViewStyle(.page) + 计数器 overlay",
    "ImageGrid": "Grid（仅 iPad regular）",
    "Carousel": "ScrollView(.horizontal) + .scrollTargetBehavior(.viewAligned)",
    "Card": "VStack + background + shadow",
    "StickyBar": ".safeAreaInset(edge: .bottom)",
    "List": "VStack（不用 List，避免系统分组样式）", "ListItem": "HStack(Image, VStack(Text, Text))",
    "Section": "VStack + 标题 Text",
    "Badge": "Text + Capsule 背景", "Rating": "Label(\"4.92\", systemImage: \"star.fill\")", "Metric": "VStack",
    "Avatar": "AsyncImage + .clipShape(Circle())",
    "Divider": "Divider()",
    "Skeleton": ".redacted(reason: .placeholder)",
    "EmptyState": "ContentUnavailableView",
    "DateRangePicker": "自研（系统 DatePicker 不支持范围选择）",
    "DateField": "Button 打开日期 sheet",
    "FieldGroup": "VStack + RoundedRectangle 边框",
    "TextField": "TextField(prompt:)；lines > 1 → axis: .vertical + lineLimit(lines, reservesSpace: true)",
    "Stepper": "自研 − / + 按钮（系统 Stepper 外观不匹配）",
    "PriceBreakdown": "Grid 两列",
    "Map": "MapKit Map；approx → MapCircle，否则 Marker"
  },
  "actions": {
    "navigate": "NavigationLink(value:) / path.append", "back": "dismiss()",
    "open": ".sheet + .presentationDetents([.large])",
    "share": "ShareLink(item: url)", "toggle": "@State 取反",
    "scrollTo": "ScrollViewReader.scrollTo(id)", "call": "数据层同名的 async throws 方法；命令乐观更新 + 触感反馈 .sensoryFeedback", "set": "@State 赋值"
  }
}
